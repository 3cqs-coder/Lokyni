<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= appName %></title>
  <meta name="description" content="Sign in to <%= appName %>.">
  <meta name="theme-color" content="#0f0f0f" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#f0f0ee" media="(prefers-color-scheme: light)">
  <meta name="color-scheme" content="dark">
  <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/fonts/fonts.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : 0 %>">
  <link rel="stylesheet" href="/css/app.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : 0 %>">
  <script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
    // Apply the saved theme before first paint so a light/sepia user never sees a dark flash, and set the
    // browser/PWA chrome color to match the chosen theme (the two media metas above follow the OS, not the
    // saved app theme, and have no sepia value). Mirrors the document viewer's head script.
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'sepia') document.documentElement.classList.add(t);
        var bg = { light: '#f0f0ee', sepia: '#f4ecd8' }[t] || '#0f0f0f';
        document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) { m.remove(); });
        var m = document.createElement('meta'); m.setAttribute('name', 'theme-color'); m.setAttribute('content', bg); document.head.appendChild(m);
      } catch (e) { /* storage unavailable — keep the default theme */ }
    })();
  </script>
  <style>
    .login-wrap { min-height: 100vh; min-height: 100dvh; display: flex; align-items: center; justify-content: center; padding: 24px 16px calc(24px + env(safe-area-inset-bottom, 0px)); }
    .login-card { width: 100%; max-width: 380px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 28px 24px; box-shadow: 0 8px 32px rgba(0,0,0,0.18); }
    .login-logo { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
    .login-logo img { width: 28px; height: 28px; }
    .login-logo h1 { font-size: 20px; margin: 0; color: var(--text); }
    .login-sub { color: var(--text-mid); font-size: 13px; margin: 0 0 20px; }
    .login-card label { display: block; font-size: 12px; color: var(--text-mid); margin: 14px 0 6px; }
    .login-card input { width: 100%; max-width: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--text); font-size: 16px; }
    .login-card input:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--accent); }
    .login-btn { width: 100%; margin-top: 20px; padding: 11px; border: none; border-radius: 8px; background: var(--accent-strong); color: #fff; font-size: 15px; font-weight: 600; cursor: pointer; }
    .login-btn:disabled { opacity: 0.6; cursor: default; }
    .login-msg { margin-top: 14px; font-size: 13px; min-height: 18px; }
    .login-msg.error { color: var(--error); }
    .login-toggle { margin-top: 18px; text-align: center; font-size: 13px; color: var(--text-mid); }
    .login-toggle a { color: var(--accent); cursor: pointer; text-decoration: none; }
    .login-or { display: flex; align-items: center; gap: 10px; margin: 18px 0 14px; color: var(--text-mid); font-size: 12px; }
    .login-or::before, .login-or::after { content: ""; flex: 1; height: 1px; background: var(--border); }
    .login-sso { width: 100%; padding: 11px; border: 1px solid var(--border); border-radius: 8px; background: transparent; color: var(--text); font-size: 15px; font-weight: 600; cursor: pointer; }
  </style>
</head>
<body>
  <div class="login-wrap">
    <main class="login-card" role="main">
      <div class="login-logo"><img src="/icons/icon.svg" alt=""><h1><%= appName %></h1></div>
      <p class="login-sub" id="login-sub">Sign in to continue.</p>
      <form id="auth-form" autocomplete="on">
        <label for="username">Username</label>
        <input id="username" name="username" type="text" autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" required>
        <label for="displayname" id="displayname-label" style="display:none;">Your name <span style="opacity:.6">(optional; any language)</span></label>
        <input id="displayname" name="displayname" type="text" autocomplete="name" maxlength="64" style="display:none;">
        <label for="email" id="email-label" style="display:none;">Email <span style="opacity:.6">(optional)</span></label>
        <input id="email" name="email" type="email" autocomplete="email" style="display:none;">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
        <button class="login-btn" id="submit-btn" type="submit">Sign in</button>
        <div class="login-msg" id="msg" role="status" aria-live="polite" aria-atomic="true"></div>
      </form>
      <div id="sso-wrap" style="display:none;">
        <div class="login-or">or</div>
        <button type="button" class="login-sso" id="sso-btn">Sign in with SSO</button>
      </div>
      <div class="login-toggle" id="toggle-wrap" style="display:none;">
        <span id="toggle-text"></span> <a id="toggle-link" tabindex="0" role="button"></a>
      </div>
    </main>
  </div>
  <script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
  (function () {
    var form = document.getElementById('auth-form');
    var sub = document.getElementById('login-sub');
    var msg = document.getElementById('msg');
    var submitBtn = document.getElementById('submit-btn');
    var emailField = document.getElementById('email');
    var emailLabel = document.getElementById('email-label');
    var dnField = document.getElementById('displayname');
    var dnLabel = document.getElementById('displayname-label');
    var toggleWrap = document.getElementById('toggle-wrap');
    var toggleText = document.getElementById('toggle-text');
    var toggleLink = document.getElementById('toggle-link');
    var pw = document.getElementById('password');
    var mode = 'login';             // 'login' | 'signup'
    var allowSignups = false, needsFirst = false, minPwLen = 8;

    // Only follow a same-origin path from ?next (open-redirect/XSS guard).
    function safeNext() {
      try {
        var n = new URLSearchParams(location.search).get('next') || '/';
        if (n[0] !== '/' || n[1] === '/' || n[1] === '\\' || /[<>"'\s]/.test(n)) return '/';
        return n;
      } catch (e) { return '/'; }
    }
    function setMode(m) {
      mode = m;
      var signup = m === 'signup';
      emailField.style.display = signup ? '' : 'none';
      emailLabel.style.display = signup ? '' : 'none';
      dnField.style.display = signup ? '' : 'none';
      dnLabel.style.display = signup ? '' : 'none';
      pw.setAttribute('autocomplete', signup ? 'new-password' : 'current-password');
      // Creating an account must meet the server's minimum length; signing in accepts any existing password.
      if (signup) pw.minLength = minPwLen; else pw.removeAttribute('minlength');
      submitBtn.textContent = signup ? (needsFirst ? 'Create admin account' : 'Create account') : 'Sign in';
      sub.textContent = signup ? (needsFirst ? 'Create the first account. It becomes the administrator.' : 'Create your account.') : 'Sign in to continue.';
      if (needsFirst) { toggleWrap.style.display = 'none'; }
      else if (allowSignups) {
        toggleWrap.style.display = '';
        toggleText.textContent = signup ? 'Already have an account?' : "Don't have an account?";
        toggleLink.textContent = signup ? 'Sign in' : 'Create one';
      } else { toggleWrap.style.display = 'none'; }
      msg.textContent = '';
    }
    toggleLink.addEventListener('click', function () { setMode(mode === 'login' ? 'signup' : 'login'); });
    toggleLink.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleLink.click(); } });

    // Ask the server what state we're in (first account? signups on? already signed in?).
    // Surface an SSO error passed back from the callback.
    try { var ssoErr = new URLSearchParams(location.search).get('sso_error'); if (ssoErr) { msg.className = 'login-msg error'; msg.textContent = ssoErr; } } catch (e) {}

    fetch('/auth/me', { headers: { accept: 'application/json' } }).then(function (r) { return r.json(); }).then(function (s) {
      allowSignups = !!s.allowSignups;
      needsFirst = !!s.needsFirstAccount;
      if (typeof s.minPasswordLen === 'number') minPwLen = s.minPasswordLen;
      // Offer SSO when the operator has enabled it (not during first-account setup, which is a local admin).
      if (s.ssoEnabled && !needsFirst) {
        var wrap = document.getElementById('sso-wrap');
        var btn = document.getElementById('sso-btn');
        if (btn && s.ssoButtonLabel) btn.textContent = s.ssoButtonLabel;
        if (wrap) wrap.style.display = '';
        if (btn) btn.addEventListener('click', function () { location.href = '/auth/sso/login?next=' + encodeURIComponent(safeNext()); });
      }
      // In single-user mode the implicit owner reads as "authenticated", but there is no real account yet —
      // so still show the create-first-admin form here. Only a genuinely signed-in user skips the page.
      if (s.authenticated && !needsFirst) { location.replace(safeNext()); return; }
      setMode(needsFirst ? 'signup' : 'login');
    }).catch(function () { setMode('login'); });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      msg.className = 'login-msg'; msg.textContent = '';
      submitBtn.disabled = true;
      var body = { username: document.getElementById('username').value, password: pw.value };
      if (mode === 'signup' && emailField.value) body.email = emailField.value;
      if (mode === 'signup' && dnField.value) body.displayName = dnField.value;
      var url = mode === 'signup' ? '/auth/signup' : '/auth/login';
      fetch(url, { method: 'POST', headers: { 'content-type': 'application/json', accept: 'application/json' }, body: JSON.stringify(body) })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) {
          if (res.ok && res.j.ok) { location.replace(safeNext()); return; }
          msg.className = 'login-msg error';
          msg.textContent = (res.j && res.j.error) || 'Something went wrong. Please try again.';
          submitBtn.disabled = false;
        })
        .catch(function () { msg.className = 'login-msg error'; msg.textContent = 'Could not reach the server.'; submitBtn.disabled = false; });
    });
  })();
  </script>
</body>
</html>
