<div id="header" role="banner">
  <span class="logo"><img class="logo-mark" src="/icons/icon.svg" width="20" height="20" alt="" aria-hidden="true"> <%= appName %></span>

  <div id="status-badge" title="Connection and indexing status" role="status" aria-live="polite">
    <div class="dot"></div>
    <span id="status-text">connecting…</span>
  </div>

  <% if (typeof showDocPanel !== 'undefined' && showDocPanel) { %>
  <select id="workspace-select" class="hdr-select" title="Active workspace" aria-label="Active workspace"></select>
  <button class="hdr-btn" id="docs-toggle" aria-expanded="false" aria-controls="doc-panel" title="Document manager"><svg class="ico" aria-hidden="true"><use href="#ic-docs"/></svg> Documents</button>
  <button class="hdr-btn" id="new-convo" title="Start a new conversation"><svg class="ico" aria-hidden="true"><use href="#ic-new"/></svg> New</button>

  <!-- Secondary actions collapse into one overflow menu so the top bar stays uncluttered. The
       buttons keep their original ids, so their existing click handlers are unchanged; only their
       location and styling move here. -->
  <div class="hdr-menu-wrap" id="more-wrap">
    <button class="hdr-btn" id="more-btn" aria-haspopup="menu" aria-expanded="false" aria-controls="more-menu" title="More actions">
      <svg class="ico" aria-hidden="true"><use href="#ic-more"/></svg> More<span id="more-badge" class="hdr-dot hidden" aria-hidden="true"></span>
    </button>
    <div id="more-menu" class="hdr-menu" role="menu" aria-label="More actions" hidden>
      <button class="menu-row" role="menuitem" id="logs-btn" title="View logs and diagnostics">
        <span class="menu-ico" aria-hidden="true"><svg class="ico"><use href="#ic-logs"/></svg></span>
        <span class="menu-txt"><b>Logs</b><span class="menu-desc">Activity and diagnostics</span></span>
      </button>
      <button class="menu-row" role="menuitem" id="inbox-btn" title="Scheduled-automation digests">
        <span class="menu-ico" aria-hidden="true"><svg class="ico"><use href="#ic-inbox"/></svg></span>
        <span class="menu-txt"><b>Inbox</b><span class="menu-desc">Scheduled digests</span></span>
        <span id="inbox-badge" class="inbox-badge hidden">0</span>
      </button>
      <!-- Whole-corpus tools, surfaced here so they're findable without opening the Documents drawer. Each
           delegates to the existing doc-panel button (same modal, no duplicate logic). -->
      <button class="menu-row" role="menuitem" id="menu-extract" title="Extract a table across your documents">
        <span class="menu-ico" aria-hidden="true"><svg class="ico"><use href="#ic-extract"/></svg></span>
        <span class="menu-txt"><b>Extract table</b><span class="menu-desc">Pull fields into a cited grid</span></span>
      </button>
      <button class="menu-row" role="menuitem" id="menu-map" title="Open the corpus mind-map">
        <span class="menu-ico" aria-hidden="true"><svg class="ico"><use href="#ic-map"/></svg></span>
        <span class="menu-txt"><b>Mind-map</b><span class="menu-desc">Map the ideas across this workspace</span></span>
      </button>
      <button class="menu-row" role="menuitem" id="menu-notes" title="Open notes">
        <span class="menu-ico" aria-hidden="true"><svg class="ico"><use href="#ic-notes"/></svg></span>
        <span class="menu-txt"><b>Notes</b><span class="menu-desc">Searchable, #-citable notes</span></span>
      </button>
      <button class="menu-row" role="menuitem" id="help-btn" title="Open the guide — searchable help (press /)" aria-label="Open the guide">
        <span class="menu-ico" aria-hidden="true"><svg class="ico"><use href="#ic-guide"/></svg></span>
        <span class="menu-txt"><b>Guide</b><span class="menu-desc">Searchable help · press /</span></span>
      </button>
      <!-- Account controls. Hidden until the client confirms multi-user mode is active (an account exists);
           the Users row appears only for an administrator. Shown/hidden by the inline script in chat.ejs. -->
      <a class="menu-row" role="menuitem" id="acct-setup-row" href="/login" title="Create the first account and require sign-in" hidden>
        <span class="menu-ico" aria-hidden="true"><svg class="ico"><use href="#ic-setup-acct"/></svg></span>
        <span class="menu-txt"><b>Set up accounts</b><span class="menu-desc">Add sign-in to share with a team</span></span>
      </a>
      <a class="menu-row" role="menuitem" id="acct-users-row" href="/admin/users" title="Manage users and workspace access" hidden>
        <span class="menu-ico" aria-hidden="true"><svg class="ico"><use href="#ic-users"/></svg></span>
        <span class="menu-txt"><b>Users &amp; Access</b><span class="menu-desc">Accounts and workspace sharing</span></span>
      </a>
      <a class="menu-row" role="menuitem" id="acct-account-row" href="/account" title="Your account, password, and sessions" hidden>
        <span class="menu-ico" aria-hidden="true"><svg class="ico"><use href="#ic-account"/></svg></span>
        <span class="menu-txt"><b>Account</b><span class="menu-desc" id="acct-name">Password and sessions</span></span>
      </a>
      <button class="menu-row" role="menuitem" id="acct-logout-row" title="Sign out" hidden>
        <span class="menu-ico" aria-hidden="true"><svg class="ico"><use href="#ic-logout"/></svg></span>
        <span class="menu-txt"><b>Sign out</b><span class="menu-desc">End this session</span></span>
      </button>
    </div>
  </div>

  <button class="hdr-btn hdr-icon" id="settings-btn" title="Settings" aria-label="Settings"><svg class="ico" aria-hidden="true"><use href="#ic-settings"/></svg></button>
  <% } %>

  <% if (typeof provider !== 'undefined') { %>
  <span id="hdr-model" class="hdr-model" title="Active model"><svg class="ico" aria-hidden="true"><use href="#<%= provider === 'ollama' ? 'ic-local' : 'ic-cloud' %>"/></svg> <%= provider === 'openai' ? 'OpenAI' : (provider === 'anthropic' ? 'Anthropic' : 'Ollama') %> · <%= model %></span>
  <% } %>

  <button class="hdr-btn hdr-icon" id="theme-toggle" aria-label="Switch theme" title="Toggle theme"><svg class="ico" aria-hidden="true"><use href="#ic-theme"/></svg></button>
</div>
