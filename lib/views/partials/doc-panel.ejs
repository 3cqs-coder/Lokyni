<div id="doc-panel" class="collapsed">
  <div id="doc-panel-header">
    <!-- Title row: the panel name plus the always-present refresh/close. The actions sit on their own row
         below so the fixed-width (360px) drawer never has to cram seven controls into one line. -->
    <div class="doc-panel-titlerow">
      <h2 id="doc-panel-title">Documents <span id="doc-panel-ws" class="doc-panel-ws"></span></h2>
      <div class="doc-panel-titlebtns">
        <button class="hdr-btn hdr-icon" id="refresh-docs" aria-label="Refresh document list" title="Refresh list">↺</button>
        <button class="hdr-btn hdr-icon doc-panel-close" id="doc-panel-close" aria-label="Close documents panel" title="Close">✕</button>
      </div>
    </div>
    <!-- Actions row: the Generate cluster plus the workspace tools. Wraps by PANEL width, so nothing is ever
         clipped at the drawer's edge. -->
    <div class="doc-panel-actions">
      <select id="synthesize-format" class="hdr-select" title="What to generate across this workspace" aria-label="What to generate across this workspace">
        <%# Options are rendered from the server's synthesis catalog (api-core SYNTHESIS_FORMATS) so the list %>
        <%# can never drift from the formats the synthesis actually supports. %>
        <%# Emit each format's UI fields as data-attrs so the client reads them from the selected option — no %>
        <%# parallel label/description/audio map to drift (see api-core SYNTHESIS_FORMATS). %>
        <% Object.entries(synthesisFormats).forEach(function([key, fmt]) { %>
          <option value="<%= key %>" data-label="<%= fmt.label %>" data-confirm="<%= fmt.confirm || '' %>" data-audio="<%= fmt.audio ? '1' : '' %>"><%= fmt.label %></option>
        <% }); %>
      </select>
      <button class="hdr-btn" id="synthesize-ws" aria-label="Generate output across all documents" title="Generate the selected output across all documents in this workspace"><svg class="ico" aria-hidden="true"><use href="#ic-generate"/></svg> Generate</button>
      <button class="hdr-btn" id="extract-table-btn" aria-label="Extract a table across documents" title="Extract a table: define columns and pull them from every document (or the selected ones) into a cited grid"><svg class="ico" aria-hidden="true"><use href="#ic-extract"/></svg> Extract</button>
      <button class="hdr-btn" id="mindmap-btn" aria-label="Open the corpus mind-map" title="Mind-map: an interactive map of the entities across this workspace and how they connect"><svg class="ico" aria-hidden="true"><use href="#ic-map"/></svg> Map</button>
      <button class="hdr-btn" id="notes-btn" aria-label="Open notes" title="Notes: write notes that index as first-class documents — searchable, #-citable, and auto-linked to related documents"><svg class="ico" aria-hidden="true"><use href="#ic-notes"/></svg> Notes</button>
      <button class="hdr-btn" id="cite-import-btn" aria-label="Import references" title="Import references: add RIS, BibTeX, or CSL-JSON entries as documents in this workspace"><svg class="ico" aria-hidden="true"><use href="#ic-cite"/></svg> References</button>
    </div>
  </div>

  <div id="drop-zone" role="button" tabindex="0" aria-labelledby="dz-label dz-sub">
    <input type="file" id="file-input" multiple accept="<%= acceptAttr %>">
    <div class="dz-icon" aria-hidden="true">⊕</div>
    <div class="dz-label" id="dz-label">Drop files or click to upload</div>
    <div class="dz-sub" id="dz-sub"><%= typeof uploadFormats !== 'undefined' ? uploadFormats : (typeof extLabel !== 'undefined' ? extLabel : 'documents, images, and media') %> · up to <%= typeof maxUploadLabel !== 'undefined' ? maxUploadLabel : '500 MB' %> each</div>
  </div>

  <div id="upload-progress" role="status" aria-live="polite" aria-atomic="false"></div>

  <div id="url-ingest">
    <input id="url-input" type="url" placeholder="Paste a web page URL to add it" aria-label="Web page URL to add">
    <button id="url-add-btn" type="button">Add</button>
  </div>
  <div id="url-ingest-status" role="status" aria-live="polite" aria-atomic="true"></div>

  <div id="doc-filter-bar">
    <!-- Filtering is client-side over the already-loaded list, so it never blocks on the network. The
         label is separate from the input so the input's accessible name stays a plain description. -->
    <div class="doc-search">
      <span class="doc-search-ico" aria-hidden="true"><svg class="ico"><use href="#ic-search"/></svg></span>
      <input id="doc-search-input" type="search" placeholder="Filter by name or folder" aria-label="Filter documents by name or folder" aria-controls="doc-list-wrap" autocomplete="off" spellcheck="false" dir="auto">
      <button id="doc-search-clear" type="button" class="doc-search-clear" aria-label="Clear document filter" title="Clear filter" hidden>✕</button>
    </div>
    <div class="doc-filter-status">
      <span id="doc-filter-label">All documents</span>
      <label id="doc-fullcontext-toggle" class="hidden" title="Inject the selected documents in full instead of searching passages — best for short docs like IDs or forms">
        <input type="checkbox" id="doc-fullcontext-check"> full text
      </label>
      <button id="doc-select-all" title="Select all / none">Select all</button>
    </div>
  </div>

  <div id="doc-list-wrap">
    <div id="doc-list-empty" dir="auto" role="status" aria-live="polite">No documents loaded</div>
  </div>

  <!-- Indexed folders live here rather than in Settings: they're per-workspace
       content, the same as the uploaded files above, whereas Settings holds global
       install configuration (provider, model, limits). Keeping them in Settings made
       the scope ambiguous — it looked like an install-wide setting. -->
  <details id="doc-sources" class="doc-sources">
    <summary>Indexed folders <span class="doc-sources-hint">(this workspace)</span></summary>
    <div class="doc-sources-body">
      <div id="source-list"></div>
      <div class="source-add">
        <input id="source-new-path" type="text" placeholder="/Users/you/Documents or ~/Documents" aria-label="Folder path to index">
        <button id="source-browse-btn" type="button" title="Browse for a folder">Browse</button>
        <label class="source-rec"><input id="source-new-recursive" type="checkbox"> subfolders</label>
        <button id="source-add-btn" type="button">Add</button>
      </div>
      <div id="source-preview-msg" class="settings-hint" role="status" aria-live="polite" aria-atomic="true"></div>
    </div>
  </details>

  <!-- Persona is per-workspace: a short instruction added to how Lokyni answers in THIS
       workspace (tone, role, audience). Grounding is unaffected — answers still come only
       from the documents, with citations. -->
  <details id="doc-persona" class="doc-sources">
    <summary>Workspace persona <span class="doc-sources-hint">(this workspace)</span></summary>
    <div class="doc-sources-body">
      <p class="settings-hint">A short instruction for how Lokyni should answer in this workspace — its tone, role, or audience (for example, "Answer as a patient tutor for a beginner" or "Be concise and use plain language"). Answers still come only from your documents, with citations.</p>
      <textarea id="persona-text" rows="3" placeholder="e.g. Answer as a careful legal analyst; define any jargon you use." aria-label="Workspace persona instruction"></textarea>
      <div class="source-add">
        <button id="persona-save" type="button">Save persona</button>
        <button id="persona-clear" type="button" title="Remove the persona for this workspace">Clear</button>
      </div>
      <div id="persona-msg" class="settings-hint" role="status" aria-live="polite" aria-atomic="true"></div>
    </div>
  </details>

  <!-- Backup lives beside the workspace's content because that's what it archives:
       this workspace's documents, index, and folder settings — not the install. -->
  <details id="doc-backup" class="doc-sources">
    <summary>Backup &amp; restore <span class="doc-sources-hint">(this workspace)</span></summary>
    <div class="doc-sources-body">
      <div class="backup-sep">Back up</div>
      <input id="backup-passphrase" type="password" placeholder="Passphrase (optional — encrypts the file)" aria-label="Backup passphrase (optional)">
      <label class="backup-check"><input id="backup-include-index" type="checkbox" checked> include the index (larger file, no re-embedding)</label>
      <button id="backup-download" type="button" class="backup-btn">Download backup</button>

      <!-- A separate passphrase field: sharing one between backup and restore read
           as "the backup passphrase" and left people unsure what to type when
           restoring an encrypted archive. -->
      <div class="backup-sep">Restore</div>
      <input id="restore-file" type="file" accept=".lokb" aria-label="Backup file to restore">
      <input id="restore-passphrase" type="password" placeholder="Passphrase (only if the backup is encrypted)" aria-label="Restore passphrase (if the backup is encrypted)">
      <label class="backup-check"><input id="restore-overwrite" type="checkbox"> replace this workspace instead of creating a new one</label>
      <button id="restore-run" type="button" class="backup-btn">Restore from file</button>
      <button id="restore-verify" type="button" class="backup-btn" title="Check that this file is complete, readable, and restorable — without changing anything">Verify file</button>
      <div id="backup-msg" class="backup-msg" role="status" aria-live="polite" aria-atomic="true"></div>
    </div>
  </details>
</div>
