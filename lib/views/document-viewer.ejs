<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= fileName %></title>
  <!-- One theme-color the head script below sets from the saved theme, so the browser/PWA chrome matches
       the paper color in every theme (including sepia). Defaults to the dark background for the no-JS case. -->
  <meta name="theme-color" content="#0f0f0f">
  <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
  <!-- Fonts are vendored and served locally (see lib/public/fonts); no external requests. -->
  <link rel="stylesheet" href="/fonts/fonts.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : 0 %>">
  <link rel="stylesheet" href="/css/app.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : 0 %>">
  <script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
    // Apply the saved theme before first paint. The viewer is a separate page, so
    // without this it always renders in the default dark palette regardless of the
    // user's choice — and running it inline in <head> avoids a flash of the wrong
    // theme that a deferred script would cause.
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'sepia') {
          document.documentElement.classList.add(t);
        }
        // Reading text size (accessibility) — same scale the main app uses, so a viewed document matches.
        var s = parseFloat(localStorage.getItem('readScale'));
        if (s >= 0.8 && s <= 2) document.documentElement.style.setProperty('--read-scale', String(s));
        // Match the browser/PWA chrome to the theme's paper color (these are the --bg values from
        // app.css; the two dark/light ones were already inlined here as media metas). Sepia was the gap.
        var bg = { light: '#f0f0ee', sepia: '#f4ecd8' }[t];
        if (bg) {
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', bg);
        }
      } catch (e) { /* storage unavailable — fall back to the default theme */ }
    })();
  </script>
</head>
<body class="viewer-body<%= typeof embed !== 'undefined' && embed ? ' embed' : '' %>">
  <%- include('partials/icons') %>

  <div class="viewer-toolbar">
    <button class="viewer-btn" id="viewer-close-btn">✕ Close</button>
    <h1><svg class="ico" aria-hidden="true"><use href="#<%= fileIcon %>"/></svg> <%= fileName %></h1>
    <% if (fileType !== 'pdf') { %>
    <span class="viewer-meta"><%= extLabel %> · <%= fileSize %> KB</span>
    <% } %>
    <% if (highlight && fileType !== 'pdf' && fileType !== 'md') { %>
    <span class="viewer-cite-badge">◆ Cited passage highlighted</span>
    <% } %>
    <a class="viewer-btn" href="<%= rawUrl %>" download="<%= fileName %>">⬇ Download</a>
    <% if (docId) { %>
    <button class="viewer-btn" id="viewer-related-btn" style="display:none;">◈ Related <span id="viewer-related-count"></span></button>
    <% } %>
  </div>

  <% if (fileType === 'pdf') { %>
    <% if (highlight) { %>
    <div class="viewer-cite-note">The cited passage is around characters <%= highlight.start %>–<%= highlight.end %> of the extracted text. PDF highlighting isn't available inline — use your reader's search to locate it.</div>
    <% } %>
    <!-- A visible open/download link that is ALWAYS shown (it is not in the toolbar, which embed mode
         hides). iOS Safari/WKWebView don't reliably render a PDF inside an <iframe> — the frame comes
         up blank — so without this an iPhone/iPad user would be stranded on a blank overlay with no
         way to reach the file. On desktop browsers the inline frame still renders as before. -->
    <div class="viewer-pdf-actions"><a class="viewer-btn" href="<%= rawUrl %>" download="<%= fileName %>">⬇ Open / Download PDF</a></div>
    <iframe src="<%= rawUrl %>" title="<%= fileName %>" role="main"></iframe>
  <% } else { %>
    <div class="viewer-content" role="main">
      <% if (fileType === 'md') { %>
        <% if (highlight) { %>
        <div class="viewer-cite-note">The cited passage is around characters <%= highlight.start %>–<%= highlight.end %> of the extracted text. Inline highlighting isn't available for rendered Markdown — use your browser's find (Ctrl or Cmd + F) to locate it.</div>
        <% } %>
        <div class="markdown"><%- renderedContent %></div>
      <% } else { %>
        <pre id="doc-pre"><%= rawContent %></pre>
      <% } %>
    </div>
  <% } %>

  <% if (highlight && fileType !== 'pdf' && fileType !== 'md') { %>
  <div id="cite-highlight-data" data-start="<%= highlight.start %>" data-end="<%= highlight.end %>"></div>
  <script src="/js/viewer-highlight.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : 0 %>"></script>
  <% } %>
  <% if (docId) { %>
  <div class="viewer-related-overlay hidden" id="viewer-related-overlay" data-doc-id="<%= docId %>" data-workspace="<%= workspaceId || '' %>">
    <div class="viewer-related-modal" role="dialog" aria-modal="true" aria-labelledby="viewer-related-title">
      <div class="viewer-related-modal-head">
        <h2 class="viewer-related-title" id="viewer-related-title">Related documents</h2>
        <button class="viewer-btn" id="viewer-related-close" aria-label="Close">✕</button>
      </div>
      <ul class="viewer-related-list" id="viewer-related-list"></ul>
      <p class="viewer-related-empty hidden" id="viewer-related-empty">No related documents found.</p>
    </div>
  </div>
  <% } %>
  <script src="/js/viewer-related.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : 0 %>"></script>

</body>
</html>
