<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Users &amp; Access · <%= appName %></title>
  <meta name="theme-color" content="#0f0f0f" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#f0f0ee" media="(prefers-color-scheme: light)">
  <meta name="color-scheme" content="dark">
  <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/fonts/fonts.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : 0 %>">
  <link rel="stylesheet" href="/css/app.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : 0 %>">
  <script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">(function(){try{var t=localStorage.getItem('theme');if(t==='light'||t==='sepia')document.documentElement.classList.add(t);var bg={light:'#f0f0ee',sepia:'#f4ecd8'}[t]||'#0f0f0f';document.querySelectorAll('meta[name="theme-color"]').forEach(function(m){m.remove();});var m=document.createElement('meta');m.setAttribute('name','theme-color');m.setAttribute('content',bg);document.head.appendChild(m);}catch(e){}})();</script>
  <style>
    /* This is a standalone, scrolling settings page, not the chat app shell: override app.css's fixed
       flex-column body so the wrapper is a normal block that constrains to the viewport width (otherwise a
       flex item with auto side margins sizes to its content and overflows on a narrow screen). */
    body { display: block; height: auto; min-height: 100dvh; }
    .adm-wrap { max-width: 820px; margin: 0 auto; padding: 24px 16px calc(40px + env(safe-area-inset-bottom,0px)); }
    .adm-top { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-bottom: 18px; gap: 12px; }
    .adm-top h1 { font-size: 20px; margin: 0; color: var(--text); min-width: 0; }
    .adm-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 18px; }
    .adm-card h2 { font-size: 14px; margin: 0 0 12px; color: var(--text); text-transform: uppercase; letter-spacing: .05em; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th, td { text-align: left; padding: 8px 6px; border-top: 1px solid var(--border); color: var(--text); vertical-align: middle; }
    th { color: var(--text-mid); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; border-top: none; }
    /* Scope the field styling to real text fields (16px so iOS Safari does not zoom on focus); the native
       checkbox is styled separately with the theme accent instead of inheriting field padding/border. */
    select, input:not([type="checkbox"]) { padding: 7px 9px; border: 1px solid var(--border); border-radius: 7px; background: var(--bg); color: var(--text); font-size: 16px; max-width: 100%; box-sizing: border-box; }
    input[type="checkbox"] { accent-color: var(--accent); }
    .btn { padding: 8px 12px; border: none; border-radius: 7px; background: var(--accent-strong); color: #fff; font-size: 13px; font-weight: 600; cursor: pointer; }
    .btn.secondary { background: transparent; color: var(--text-mid); border: 1px solid var(--border); }
    .btn.danger { background: transparent; color: var(--error); border: 1px solid var(--border); }
    .btn:disabled { opacity: .5; cursor: default; }
    .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 10px; }
    .msg { font-size: 13px; margin-top: 10px; min-height: 16px; } .msg.error { color: var(--error); } .msg.ok { color: var(--accent); }
    .muted { color: var(--text-mid); font-size: 12px; }
    .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    #sso-fields { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    @media (max-width: 480px) { #sso-fields { grid-template-columns: 1fr; } #sso-fields label[style*="grid-column"] { grid-column: 1 !important; } }
  </style>
</head>
<body>
  <div class="adm-wrap">
    <div class="adm-top"><h1>Users &amp; Access</h1><a class="btn secondary" href="/">← Back to <%= appName %></a></div>

    <div class="adm-card">
      <h2>Add a user</h2>
      <form id="add-form" class="row">
        <input id="a-user" type="text" placeholder="Username" aria-label="New username" autocapitalize="none" autocorrect="off" spellcheck="false" required>
        <input id="a-email" type="email" placeholder="Email (optional)" aria-label="Email (optional)">
        <input id="a-pass" type="password" placeholder="Password (8+ chars)" aria-label="Password" autocomplete="new-password" required>
        <select id="a-role" aria-label="Role"><option value="member">Member</option><option value="admin">Admin</option></select>
        <button class="btn" id="a-btn" type="submit">Add user</button>
      </form>
      <div class="msg" id="add-msg" role="status" aria-live="polite" aria-atomic="true"></div>
    </div>

    <div class="adm-card">
      <h2>Users</h2>
      <div class="table-wrap"><table><thead><tr><th>Username</th><th>Role</th><th>Status</th><th></th></tr></thead><tbody id="users-body"><tr><td colspan="4" class="muted">Loading…</td></tr></tbody></table></div>
      <div class="msg" id="users-msg" role="status" aria-live="polite" aria-atomic="true"></div>
    </div>

    <div class="adm-card">
      <h2>Workspace access</h2>
      <div class="row">
        <label class="muted" for="ws-select">Workspace</label>
        <select id="ws-select"></select>
      </div>
      <div class="table-wrap" style="margin-top:12px;"><table><thead><tr><th>User</th><th>Role</th><th></th></tr></thead><tbody id="members-body"><tr><td colspan="3" class="muted">Choose a workspace.</td></tr></tbody></table></div>
      <div class="row">
        <select id="m-user" aria-label="User to grant access"></select>
        <select id="m-role" aria-label="Workspace role"><option value="viewer">Viewer</option><option value="editor">Editor</option><option value="admin">Admin</option><option value="owner">Owner</option></select>
        <button class="btn" id="m-add" type="button">Add / update access</button>
      </div>
      <div class="msg" id="members-msg" role="status" aria-live="polite" aria-atomic="true"></div>
      <p class="muted" style="margin-top:8px;">Viewer can ask questions · Editor can add and remove documents · Admin can manage the workspace and its members · Owner can also delete it.</p>
    </div>

    <div class="adm-card">
      <h2>Single sign-on (SSO)</h2>
      <p class="muted" style="margin-top:-4px;margin-bottom:12px;">Let people sign in with your organization's identity provider (OpenID Connect). Local accounts keep working alongside it.</p>
      <label style="display:flex;align-items:center;gap:8px;font-size:14px;color:var(--text);"><input type="checkbox" id="s-enabled" style="width:auto;"> Enable single sign-on</label>
      <div id="sso-fields" style="margin-top:12px;display:grid;gap:10px 12px;">
        <label class="muted" style="grid-column:1/3;">Issuer URL (your provider's base URL)<input id="s-issuer" type="url" placeholder="https://your-provider.example.com" style="width:100%;margin-top:4px;"></label>
        <label class="muted">Client ID<input id="s-clientId" type="text" style="width:100%;margin-top:4px;"></label>
        <label class="muted">Client secret<input id="s-clientSecret" type="password" autocomplete="new-password" placeholder="" style="width:100%;margin-top:4px;"></label>
        <label class="muted">Redirect URI (register this with your provider)<input id="s-redirectUri" type="url" placeholder="(auto if blank)" style="width:100%;margin-top:4px;"></label>
        <label class="muted">Button label<input id="s-buttonLabel" type="text" placeholder="Sign in with SSO" style="width:100%;margin-top:4px;"></label>
        <label class="muted">Scopes<input id="s-scopes" type="text" placeholder="openid profile email" style="width:100%;margin-top:4px;"></label>
        <label class="muted">New users<span style="display:block;margin-top:4px;"><select id="s-autoCreate" style="width:100%;"><option value="true">Create automatically on first sign-in</option><option value="false">Only existing accounts (admin creates them)</option></select></span></label>
        <label class="muted">Link by verified email<span style="display:block;margin-top:4px;"><select id="s-linkByEmail" style="width:100%;"><option value="true">Link a verified email to an existing account (single trusted provider)</option><option value="false">Never link by email — match only by provider subject</option></select></span></label>
        <label class="muted">Default role for new users<span style="display:block;margin-top:4px;"><select id="s-defaultRole" style="width:100%;"><option value="member">Member</option><option value="admin">Admin</option></select></span></label>
        <label class="muted">Username claim<input id="s-usernameClaim" type="text" placeholder="preferred_username" style="width:100%;margin-top:4px;"></label>
        <label class="muted">Email claim<input id="s-emailClaim" type="text" placeholder="email" style="width:100%;margin-top:4px;"></label>
      </div>
      <div class="row" style="margin-top:14px;">
        <button class="btn" id="s-save" type="button">Save SSO settings</button>
        <button class="btn secondary" id="s-test" type="button">Test connection</button>
      </div>
      <div class="msg" id="sso-msg" role="status" aria-live="polite" aria-atomic="true"></div>
    </div>
  </div>

  <script src="/js/authpage.js?v=<%= assetVersion %>" nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>"></script>
  <script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
  (function () {
    // CSRF token, request-header builder, and HTML-escaper are shared with the account page (see authpage.js).
    var esc = AuthPage.esc, hdrs = AuthPage.hdrs;
    // These enums default here but are REPLACED by the authoritative lists the server sends (/auth/users and
    // /auth/me), so adding or renaming a role/status server-side updates the pickers without editing this page.
    var allUsers = [], wsRoles = ['viewer','editor','admin','owner'], userRoles = ['admin','member'], statuses = ['active','disabled'], minPwLen = 8;
    function cap(s) { s = String(s == null ? '' : s); return s.charAt(0).toUpperCase() + s.slice(1); }
    // Build a <select>'s options from a value list, capitalizing the label while keeping the lowercase value.
    function optList(values, selected) { return values.map(function (v) { return '<option value="' + esc(v) + '"' + (v === selected ? ' selected' : '') + '>' + esc(cap(v)) + '</option>'; }).join(''); }
    function setMsg(id, cls, txt) { var e = document.getElementById(id); e.className = 'msg ' + (cls || ''); e.textContent = txt || ''; }

    AuthPage.me(function (s) {
      if (!s.isAdmin) { location.href = s.authenticated ? '/' : '/login'; return; }
      if (typeof s.minPasswordLen === 'number') { minPwLen = s.minPasswordLen; var ap = document.getElementById('a-pass'); if (ap) { ap.minLength = minPwLen; ap.placeholder = 'Password (' + minPwLen + '+ chars)'; } }
      loadUsers(); loadWorkspaces(); loadSso();
    }).catch(function () {});

    // ── Add user ──
    document.getElementById('add-form').addEventListener('submit', function (e) {
      e.preventDefault(); setMsg('add-msg', '', '');
      var btn = document.getElementById('a-btn'); btn.disabled = true;
      var body = { username: document.getElementById('a-user').value, password: document.getElementById('a-pass').value, role: document.getElementById('a-role').value };
      var em = document.getElementById('a-email').value; if (em) body.email = em;
      fetch('/auth/users', { method: 'POST', headers: hdrs(true), body: JSON.stringify(body) })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) {
          btn.disabled = false;
          if (res.ok && res.j.ok) { setMsg('add-msg', 'ok', 'Added ' + res.j.user.username + '.'); document.getElementById('add-form').reset(); loadUsers(); }
          else setMsg('add-msg', 'error', (res.j && res.j.error) || 'Could not add the user.');
        }).catch(function () { btn.disabled = false; setMsg('add-msg', 'error', 'Could not reach the server.'); });
    });

    // ── Users table ──
    function loadUsers() {
      fetch('/auth/users', { headers: { accept: 'application/json' } }).then(function (r) { return r.json(); }).then(function (s) {
        allUsers = s.users || [];
        if (Array.isArray(s.roles) && s.roles.length) userRoles = s.roles;
        if (Array.isArray(s.statuses) && s.statuses.length) statuses = s.statuses;
        if (Array.isArray(s.workspaceRoles) && s.workspaceRoles.length) wsRoles = s.workspaceRoles;
        // Fill the static add-user / workspace-role pickers from the authoritative lists (capitalized labels).
        var ar = document.getElementById('a-role'); if (ar) ar.innerHTML = optList(userRoles, 'member');
        var mr = document.getElementById('m-role'); if (mr) mr.innerHTML = optList(wsRoles, 'viewer');
        var body = document.getElementById('users-body');
        body.innerHTML = allUsers.map(function (u) {
          var roleSel = '<select aria-label="Role for ' + esc(u.username) + '" data-act="role" data-id="' + esc(u.id) + '" data-cur="' + esc(u.role) + '">' + optList(userRoles, u.role) + '</select>';
          var statusSel = '<select aria-label="Status for ' + esc(u.username) + '" data-act="status" data-id="' + esc(u.id) + '" data-cur="' + esc(u.status) + '">' + optList(statuses, u.status) + '</select>';
          var del = u.isInitial ? '<span class="muted">initial admin</span>' : '<button type="button" class="btn danger" data-act="delete" data-id="' + esc(u.id) + '" data-name="' + esc(u.username) + '">Delete</button>';
          // Show the resolved display name (server-computed name = display name, else username), with the @username
          // beside it when they differ so the sign-in identifier stays visible.
          var nameCell = esc(u.name || u.username)
            + (u.name && u.name !== u.username ? ' <span class="muted">@' + esc(u.username) + '</span>' : '')
            + (u.isInitial ? ' <span class="muted">(initial)</span>' : '');
          return '<tr><td>' + nameCell + '</td><td>' + roleSel + '</td><td>' + statusSel + '</td><td>' + del + '</td></tr>';
        }).join('');
        // populate the "add member" user picker — show the human name for clarity, keyed by the stable id
        var mu = document.getElementById('m-user');
        mu.innerHTML = allUsers.map(function (u) { return '<option value="' + esc(u.id) + '">' + esc(u.name || u.username) + '</option>'; }).join('');
      }).catch(function () {});
    }

    document.getElementById('users-body').addEventListener('change', function (e) {
      var sel = e.target; if (sel.tagName !== 'SELECT') return;
      var act = sel.getAttribute('data-act'), id = sel.getAttribute('data-id'), cur = sel.getAttribute('data-cur');
      // Confirm the consequential changes before they take effect (they fire on the select's change): demoting an
      // admin, or disabling an account (which also signs them out everywhere). Revert the picker on cancel. The
      // themed AuthPage.confirm replaces the native browser dialog (unreliable/suppressible in the desktop webview).
      var warn = (act === 'role' && cur === 'admin' && sel.value !== 'admin') ? 'Remove admin from this user?'
        : (act === 'status' && sel.value === 'disabled') ? 'Disable this account? It will be signed out everywhere and cannot sign in.'
        : '';
      var gate = warn ? AuthPage.confirm({ title: warn, okLabel: 'Yes', danger: true }) : Promise.resolve(true);
      gate.then(function (ok) {
        if (!ok) { sel.value = cur; return; }
        var patch = {}; patch[act] = sel.value;
        sel.setAttribute('data-cur', sel.value);   // remember the new current value for the next change
        fetch('/auth/users/' + id, { method: 'PATCH', headers: hdrs(true), body: JSON.stringify(patch) })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (res) { if (res.ok && res.j.ok) setMsg('users-msg', 'ok', 'Updated.'); else { setMsg('users-msg', 'error', (res.j && res.j.error) || 'Could not update.'); loadUsers(); } })
          .catch(function () { setMsg('users-msg', 'error', 'Could not reach the server.'); });
      });
    });
    document.getElementById('users-body').addEventListener('click', function (e) {
      var btn = e.target.closest('button[data-act="delete"]'); if (!btn) return;
      AuthPage.confirm({ title: 'Delete user "' + btn.getAttribute('data-name') + '"?', message: 'This removes their access, sessions, and API keys. This cannot be undone.', okLabel: 'Delete', danger: true }).then(function (ok) {
        if (!ok) return;
        fetch('/auth/users/' + btn.getAttribute('data-id'), { method: 'DELETE', headers: hdrs(false) })
          .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
          .then(function (res) { if (res.ok && res.j.ok) { setMsg('users-msg', 'ok', 'Deleted.'); loadUsers(); } else setMsg('users-msg', 'error', (res.j && res.j.error) || 'Could not delete.'); })
          .catch(function () { setMsg('users-msg', 'error', 'Could not reach the server.'); });
      });
    });

    // ── Workspace membership ──
    function loadWorkspaces() {
      fetch('/api/workspaces', { headers: { accept: 'application/json' } }).then(function (r) { return r.json(); }).then(function (s) {
        var sel = document.getElementById('ws-select');
        sel.innerHTML = (s.workspaces || []).map(function (w) { return '<option value="' + esc(w.id) + '">' + esc(w.name || w.id) + '</option>'; }).join('');
        if (sel.value) loadMembers();
      }).catch(function () {});
    }
    document.getElementById('ws-select').addEventListener('change', loadMembers);
    function loadMembers() {
      var ws = document.getElementById('ws-select').value; if (!ws) return;
      fetch('/auth/workspaces/' + encodeURIComponent(ws) + '/members', { headers: { accept: 'application/json' } }).then(function (r) { return r.json(); }).then(function (s) {
        var body = document.getElementById('members-body');
        if (!s.members || !s.members.length) { body.innerHTML = '<tr><td colspan="3" class="muted">No one has been granted access yet.</td></tr>'; return; }
        body.innerHTML = s.members.map(function (m) {
          var roleSel = '<select aria-label="Workspace role for ' + esc(m.username) + '" data-uid="' + esc(m.userId) + '">' + optList(wsRoles, m.role) + '</select>';
          return '<tr><td>' + esc(m.username) + '</td><td>' + roleSel + '</td><td><button type="button" class="btn danger" data-rm="' + esc(m.userId) + '">Remove</button></td></tr>';
        }).join('');
      }).catch(function () {});
    }
    document.getElementById('members-body').addEventListener('change', function (e) {
      if (e.target.tagName !== 'SELECT') return;
      setMember(e.target.getAttribute('data-uid'), e.target.value);
    });
    document.getElementById('members-body').addEventListener('click', function (e) {
      var btn = e.target.closest('button[data-rm]'); if (!btn) return;
      var ws = document.getElementById('ws-select').value;
      // Confirm — removing a member revokes their access to this workspace.
      AuthPage.confirm({ title: 'Remove this member?', message: 'They will lose access to this workspace.', okLabel: 'Remove', danger: true }).then(function (ok) {
        if (!ok) return;
        fetch('/auth/workspaces/' + encodeURIComponent(ws) + '/members/' + encodeURIComponent(btn.getAttribute('data-rm')), { method: 'DELETE', headers: hdrs(false) })
          .then(function () { setMsg('members-msg', 'ok', 'Removed.'); loadMembers(); }).catch(function () { setMsg('members-msg', 'error', 'Could not remove.'); });
      });
    });
    document.getElementById('m-add').addEventListener('click', function () {
      setMember(document.getElementById('m-user').value, document.getElementById('m-role').value);
    });
    function setMember(userId, role) {
      var ws = document.getElementById('ws-select').value; if (!ws || !userId) return;
      fetch('/auth/workspaces/' + encodeURIComponent(ws) + '/members/' + encodeURIComponent(userId), { method: 'PUT', headers: hdrs(true), body: JSON.stringify({ role: role }) })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) { if (res.ok && res.j.ok) { setMsg('members-msg', 'ok', 'Access updated.'); loadMembers(); } else setMsg('members-msg', 'error', (res.j && res.j.error) || 'Could not update access.'); })
        .catch(function () { setMsg('members-msg', 'error', 'Could not reach the server.'); });
    }

    // ── Single sign-on settings ──
    var g = function (id) { return document.getElementById(id); };
    function loadSso() {
      fetch('/api/sso', { headers: { accept: 'application/json' } }).then(function (r) { return r.json(); }).then(function (s) {
        var o = s.oidc || {};
        g('s-enabled').checked = !!o.enabled;
        g('s-issuer').value = o.issuer || '';
        g('s-clientId').value = o.clientId || '';
        g('s-clientSecret').value = '';
        g('s-clientSecret').placeholder = o.secretSet ? '•••••••• (set — leave blank to keep)' : '';
        g('s-redirectUri').value = o.redirectUri || '';
        g('s-buttonLabel').value = o.buttonLabel || '';
        g('s-scopes').value = o.scopes || '';
        g('s-autoCreate').value = o.autoCreateUsers === false ? 'false' : 'true';
        g('s-linkByEmail').value = o.linkByEmail === false ? 'false' : 'true';
        g('s-defaultRole').value = o.defaultRole === 'admin' ? 'admin' : 'member';
        g('s-usernameClaim').value = o.usernameClaim || '';
        g('s-emailClaim').value = o.emailClaim || '';
      }).catch(function () {});
    }
    function ssoBody() {
      return {
        enabled: g('s-enabled').checked, issuer: g('s-issuer').value, clientId: g('s-clientId').value,
        clientSecret: g('s-clientSecret').value, redirectUri: g('s-redirectUri').value, buttonLabel: g('s-buttonLabel').value,
        scopes: g('s-scopes').value, autoCreateUsers: g('s-autoCreate').value !== 'false', linkByEmail: g('s-linkByEmail').value !== 'false', defaultRole: g('s-defaultRole').value,
        usernameClaim: g('s-usernameClaim').value, emailClaim: g('s-emailClaim').value,
      };
    }
    g('s-save').addEventListener('click', function () {
      setMsg('sso-msg', '', '');
      fetch('/api/sso', { method: 'POST', headers: hdrs(true), body: JSON.stringify(ssoBody()) })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) { if (res.ok && res.j.ok) { setMsg('sso-msg', 'ok', 'Saved. Changes take effect immediately.'); loadSso(); } else setMsg('sso-msg', 'error', (res.j && res.j.error) || 'Could not save.'); })
        .catch(function () { setMsg('sso-msg', 'error', 'Could not reach the server.'); });
    });
    g('s-test').addEventListener('click', function () {
      setMsg('sso-msg', '', 'Testing…');
      fetch('/api/sso/test', { method: 'POST', headers: hdrs(true), body: JSON.stringify({ issuer: g('s-issuer').value }) })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) { if (res.ok && res.j.ok) setMsg('sso-msg', 'ok', 'Reached the provider — discovery succeeded.'); else setMsg('sso-msg', 'error', (res.j && res.j.error) || 'Could not reach the provider.'); })
        .catch(function () { setMsg('sso-msg', 'error', 'Could not reach the server.'); });
    });
  })();
  </script>
</body>
</html>
