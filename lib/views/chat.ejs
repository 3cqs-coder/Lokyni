<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= appName %></title>
  <meta name="description" content="Answers questions from your own documents, with sources — private, local, and able to run offline.">
  <% if (typeof desktop !== 'undefined' && desktop) { %>
  <!-- Set by the desktop shell. Tells the client to route external links to the system browser
       (the shell's navigation handler opens them) rather than the single desktop webview. -->
  <meta name="lokyni-desktop" content="1">
  <% } %>
  <!-- The human-facing supported-format list, sourced from the single server constant so a client
       hint can never drift from what the extractor actually accepts. -->
  <meta name="lokyni-ext-label" content="<%= extLabel %>">
  <!-- The turn-control protocol (Stop, stopped, end, progress), handed off from the server so the
       event names the browser listens for are the exact ones the server emits. -->
  <meta name="lokyni-turn-protocol" content="<%= JSON.stringify(typeof turnProtocol !== 'undefined' ? turnProtocol : {}) %>">
  <!-- The settings schema projection: defaults, numeric input bounds, and provider model defaults.
       The server is the source; the page never carries a second copy of these values. -->
  <meta name="lokyni-settings" content="<%= JSON.stringify(typeof settingsSchema !== 'undefined' ? settingsSchema : {}) %>">

  <!-- Installable web app (PWA): its own window and launcher icon, served entirely by the
       local app with no external requests. -->
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#0f0f0f" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#f0f0ee" media="(prefers-color-scheme: light)">
  <!-- The app's default theme is dark; light and sepia set `color-scheme` themselves in CSS
       (see app.css). Declaring a single scheme here — rather than "dark light", which would
       defer to the OS — keeps native controls matching the chosen app theme, not the OS. -->
  <meta name="color-scheme" content="dark">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="<%= appName %>">
  <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
  <link rel="icon" href="/icons/icon-192.png" sizes="192x192" type="image/png">
  <link rel="apple-touch-icon" href="/icons/icon-180.png">

  <!-- Fonts are vendored and served locally (see lib/public/fonts); the app never contacts a
       font CDN. Loaded before the stylesheet so text paints in the intended typeface. -->
  <link rel="stylesheet" href="/fonts/fonts.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : 0 %>">
  <link rel="stylesheet" href="/css/app.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : 0 %>">
  <script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
    // Apply the saved theme before first paint, so a light/sepia user never sees a flash of
    // the default dark palette. chat.js's applyTheme keeps <html> and <body> in sync after load.
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'sepia') document.documentElement.classList.add(t);
        // Rewrite the browser/PWA chrome color to match the SAVED app theme, like the sister pages do. The two
        // media metas above follow the OS scheme and carry no sepia value, so without this a sepia user — or a
        // user whose app theme differs from the OS — sees the wrong status-bar color until chat.js runs.
        var bg = { light: '#f0f0ee', sepia: '#f4ecd8' }[t] || '#0f0f0f';
        document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) { m.remove(); });
        var tc = document.createElement('meta'); tc.setAttribute('name', 'theme-color'); tc.setAttribute('content', bg); document.head.appendChild(tc);
        // Reading text size (accessibility): restore the saved scale before first paint so bigger text never
        // flashes at the default size. chat.js's applyReadScale keeps it in sync after load.
        var s = parseFloat(localStorage.getItem('readScale'));
        if (s >= 0.8 && s <= 2) document.documentElement.style.setProperty('--read-scale', String(s));
      } catch (e) { /* storage unavailable — fall back to the defaults */ }
    })();
  </script>
  <script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
    // Register the service worker so the app is installable as a standalone window. It is a
    // network-only pass-through (see /sw.js) — it never caches the UI — so this can never
    // leave a browser running stale code. Best-effort: a failure here changes nothing.
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () {
        navigator.serviceWorker.register('/sw.js').catch(function () { /* ignore */ });
      });
    }
  </script>
</head>
<body>
  <%- include('partials/icons') %>
  <a href="#main" class="skip-link">Skip to main content</a>

  <!-- Present at load so screen readers reliably announce the first message/toast of a session: a live
       region inserted and filled in the same tick is often missed. announce() reuses #a11y-live; toasts
       are appended into #toast-wrap (each toast carries its own role, so the wrapper is not a live region). -->
  <div id="a11y-live" class="sr-only" aria-live="polite" aria-atomic="true"></div>
  <div id="toast-wrap" class="toast-wrap"></div>

  <%- include('partials/header', { showDocPanel: true, provider: provider, model: model, appName: appName }) %>

  <!-- Shown only on a read replica in a multi-instance deployment: reading works here, but document and
       settings changes are made on the primary. Revealed by the inline probe of /status below. -->
  <div id="replica-banner" role="status" hidden style="display:none;background:var(--surface);border-bottom:1px solid var(--border);color:var(--text-mid);font-size:12px;padding:6px 12px;text-align:center;">
    <span aria-hidden="true">◫</span> Read-only replica — you can search and chat here; document and setting changes are made on the primary.
  </div>

  <main id="main" tabindex="-1">
    <h1 class="sr-only"><%= appName %> — ask questions about your documents</h1>
    <div id="chat-col">
      <div id="chat-box">
        <div id="empty-state">
          <!-- Onboarding state, shown only once the workspace is confirmed to have NO documents (the status
               heartbeat reports `empty`). A brand-new user's real first step is to add a document, so point
               them straight at it rather than at a question that cannot be answered yet. Hidden by default so
               an existing corpus never flashes it on load; toggled by setEmptyStateMode(). -->
          <div id="empty-onboard" style="display:none">
            <div class="icon"><svg class="ico" aria-hidden="true"><use href="#ic-docs"/></svg></div>
            <div class="label">Add a document to get started</div>
            <div class="sublabel">Drop a PDF, Word doc, or text file — or paste a web page URL. Then ask questions and get answers with sources.</div>
            <button type="button" id="empty-add-doc" class="picker-primary">Add a document</button>
          </div>
          <!-- Ask state (the default): shown once at least one document is indexed. -->
          <div id="empty-ask">
            <div class="icon"><svg class="ico" aria-hidden="true"><use href="#ic-search"/></svg></div>
            <div class="label">ask a question about your documents</div>
            <div class="sublabel">Answers come only from your files, with sources — and Lokyni tells you when they don't have the answer.</div>
            <!-- Starter prompts help a first-time user succeed without hunting for what to type. They
                 fill the box (they do not send), so the question can be edited first. -->
            <div id="starter-pills" class="starter-pills">
              <button type="button" class="starter-pill" data-q="Give me an overview of these documents.">Give me an overview</button>
              <button type="button" class="starter-pill" data-q="What are the main themes across these documents?">What are the main themes?</button>
              <button type="button" class="starter-pill" data-q="What are the key takeaways?">What are the key takeaways?</button>
            </div>
          </div>
        </div>
      </div>
      <div id="input-area">
        <div id="hash-picker" class="hash-picker hidden"></div>
        <div id="slash-picker" class="hash-picker hidden"></div>
        <div id="attach-chips" class="attach-chips hidden"></div>
        <!-- Active answer options appear here as removable chips, so it is always clear what is on
             before sending. Default-on options (Explain, Learn) are the baseline and get no chip. -->
        <div id="tool-chips" class="tool-chips hidden" aria-label="Active answer options"></div>
        <form id="input-form">
          <button type="button" id="attach-btn" aria-label="Attach a file" title="Attach a file to ask about it (this message only — not added to your library)"><svg class="ico" aria-hidden="true"><use href="#ic-attach"/></svg></button>
          <input type="file" id="attach-input" style="display:none" accept="<%= acceptAttr %>">
          <!-- Every optional answer mode lives behind one Tools menu so the composer stays calm.
               The buttons keep their original ids, so their existing toggle handlers are unchanged;
               only their location and styling move into this menu. -->
          <div class="tools-wrap" id="tools-wrap">
            <button type="button" id="tools-btn" class="tools-btn" aria-expanded="false" aria-controls="tools-menu" title="Answer options">
              <span class="tools-ico" aria-hidden="true"><svg class="ico"><use href="#ic-tools"/></svg></span> Tools<span id="tools-badge" class="tools-badge hidden" aria-hidden="true">0</span>
            </button>
            <!-- A panel of independent on/off options plus a date sub-group — a group of checkboxes,
                 not a command menu (a menu may only contain menuitems, so the date inputs could not
                 live inside a role="menu"). Each row is role="checkbox" with aria-checked kept in sync. -->
            <div id="tools-menu" class="tools-menu" role="group" aria-label="Answer options" hidden>
              <!-- Mobile-only sheet header. On desktop the Tools menu is a compact popover with no header;
                   at phone width it becomes a bottom sheet, and the title + close control make that
                   presentation explicit and dismissible without hunting for the trigger. -->
              <div class="sheet-head">
                <span class="sheet-title" id="tools-sheet-title">Answer options</span>
                <button type="button" class="sheet-close" id="tools-sheet-close" aria-label="Close answer options" title="Close">✕</button>
              </div>
              <div class="tools-menu-label" role="presentation">Where answers come from</div>
              <button class="tool-row" type="button" role="checkbox" aria-checked="false" id="web-search-toggle" title="Search the web OFF — answers come from your documents only">
                <span class="tool-ico" aria-hidden="true"><svg class="ico"><use href="#ic-web"/></svg></span>
                <span class="tool-txt"><b>Search the web</b><span class="tool-desc">Also look things up online. Stays on until you turn it off.</span></span>
                <span class="tool-check" aria-hidden="true"></span>
              </button>
              <button class="tool-row" type="button" role="checkbox" aria-checked="false" id="research-toggle" title="Deep Research — click to run your next question as multi-step, cited research over your documents (and the web if web search is on)">
                <span class="tool-ico" aria-hidden="true"><svg class="ico"><use href="#ic-research"/></svg></span>
                <span class="tool-txt"><b>Deep research</b><span class="tool-desc">Multi-step, cited research — runs on your next question</span></span>
                <span class="tool-check" aria-hidden="true"></span>
              </button>
              <div class="tools-menu-label" role="presentation">How answers are shown</div>
              <button class="tool-row" type="button" role="checkbox" aria-checked="true" id="why-toggle" title="Explain this answer ON — each answer shows why it used the documents it did">
                <span class="tool-ico" aria-hidden="true"><svg class="ico"><use href="#ic-explain"/></svg></span>
                <span class="tool-txt"><b>Explain the answer</b><span class="tool-desc">Show why each answer used the documents it did</span></span>
                <span class="tool-check" aria-hidden="true"></span>
              </button>
              <button class="tool-row" type="button" role="checkbox" aria-checked="false" id="verify-toggle" title="Verify OFF — click to fact-check each answer's claims against its cited sources">
                <span class="tool-ico" aria-hidden="true"><svg class="ico"><use href="#ic-verify"/></svg></span>
                <span class="tool-txt"><b>Verify the answer</b><span class="tool-desc">Fact-check each answer against its cited sources</span></span>
                <span class="tool-check" aria-hidden="true"></span>
              </button>
              <button class="tool-row" type="button" role="checkbox" aria-checked="false" id="suggest-toggle" title="Follow-up suggestions OFF — click to show one-click follow-up questions under each answer">
                <span class="tool-ico" aria-hidden="true"><svg class="ico"><use href="#ic-suggest"/></svg></span>
                <span class="tool-txt"><b>Suggest follow-ups</b><span class="tool-desc">Offer one-click follow-up questions under each answer</span></span>
                <span class="tool-check" aria-hidden="true"></span>
              </button>
              <button class="tool-row" type="button" role="checkbox" aria-checked="true" id="learn-toggle" title="Learn ON — rate answers 👍/👎 so Lokyni surfaces similar past questions and down-weights documents that led to bad answers">
                <span class="tool-ico" aria-hidden="true"><svg class="ico"><use href="#ic-learn"/></svg></span>
                <span class="tool-txt"><b>Learn from ratings</b><span class="tool-desc">Rate answers 👍/👎 to improve future results (stored on this machine)</span></span>
                <span class="tool-check" aria-hidden="true"></span>
              </button>
              <div class="tools-menu-label" role="presentation">Filter</div>
              <!-- A disclosure that reveals the date inputs (not a simple on/off like the rows above),
                   so it is a plain button with aria-expanded, not a checkbox. -->
              <button class="tool-row" type="button" id="date-filter-toggle" aria-expanded="false" aria-controls="date-filter-inputs" title="Only use documents within a date range">
                <span class="tool-ico" aria-hidden="true"><svg class="ico"><use href="#ic-date"/></svg></span>
                <span class="tool-txt"><b>Date range</b><span class="tool-desc">Only use documents within a range of dates</span></span>
                <span class="tool-check" aria-hidden="true"></span>
              </button>
              <div id="date-filter-inputs" class="hidden" role="group" aria-label="Date range">
                <label>From <input type="date" id="date-from"></label>
                <label>To <input type="date" id="date-to"></label>
                <button type="button" id="date-filter-clear" title="Clear dates">Clear</button>
              </div>
            </div>
          </div>
          <textarea id="message-input" placeholder="Ask a question…" aria-label="Ask a question about your documents" rows="1" autocomplete="off" dir="auto"></textarea>
          <!-- Push-to-talk voice input. Hidden until the feature is enabled in Settings and possible on this
               install (see chat.js sttReady). Click to record, click again to stop; the transcript fills the box
               for editing before you send. -->
          <button type="button" id="mic-btn" class="mic-btn hidden" aria-label="Ask by voice" aria-pressed="false" title="Ask by voice — click to record, click again to stop"><svg class="ico" aria-hidden="true"><use href="#ic-mic"/></svg></button>
          <!-- Hands-free voice mode: click once, then just talk. Hidden until voice input is enabled and the
               browser can record (see chat.js handsfreeReady). -->
          <button type="button" id="handsfree-btn" class="mic-btn hidden" aria-label="Hands-free voice mode" aria-pressed="false" title="Hands-free voice mode — talk to ask and hear answers back"><svg class="ico" aria-hidden="true"><use href="#ic-handsfree"/></svg></button>
          <button type="submit" id="send-button" aria-label="Send message">Send ↵</button>
        </form>
        <div class="hint">Enter to send · Shift+Enter for new line</div>
      </div>
    </div>

    <%- include('partials/doc-panel', { acceptAttr, synthesisFormats }) %>
  </main>

  <!-- New conversation confirmation -->
  <div id="new-confirm-overlay" class="modal-overlay hidden" aria-labelledby="new-confirm-title">
    <div class="modal-box">
      <div class="modal-title" id="new-confirm-title">Start new conversation?</div>
      <div class="modal-body">This permanently deletes the current conversation. Your documents stay indexed, but the conversation cannot be reopened.</div>
      <div class="modal-btns">
        <button class="modal-btn-cancel" id="new-confirm-cancel">Cancel</button>
        <button class="modal-btn-ok" id="new-confirm-ok">Start New</button>
      </div>
    </div>
  </div>

  <!-- Per-answer language override: read one answer in a language other than its detected/default one. -->
  <div id="readas-overlay" class="modal-overlay hidden" aria-labelledby="readas-title">
    <div class="modal-box">
      <div class="modal-title" id="readas-title">Read this answer as…</div>
      <div class="modal-body readas-body">
        <label for="readas-language">Language</label>
        <select id="readas-language" aria-describedby="readas-detected"></select>
        <p class="settings-hint" id="readas-detected"></p>
        <p class="settings-hint">This choice applies to this answer only and does not change your Settings default.</p>
      </div>
      <div class="modal-btns">
        <button class="modal-btn-cancel" id="readas-cancel" type="button">Cancel</button>
        <button class="modal-btn-ok" id="readas-go" type="button">Read aloud</button>
      </div>
    </div>
  </div>

  <!-- Citation interoperability: save an answer's sources for a reference manager, or bring references in as
       ordinary documents. One shared module formats and parses both sides. -->
  <div id="cite-export-overlay" class="modal-overlay hidden" aria-labelledby="cite-export-title">
    <div class="modal-box">
      <div class="modal-title" id="cite-export-title">Export citations</div>
      <div class="modal-body cite-body">
        <label for="cite-export-format">Format</label>
        <select id="cite-export-format" aria-describedby="cite-export-note">
          <% (typeof citationFormats !== 'undefined' ? citationFormats : []).forEach(function (f) { %>
            <option value="<%= f.id %>" data-ext="<%= f.ext %>" data-mime="<%= f.mime %>"><%= f.label %></option>
          <% }); %>
        </select>
        <p class="settings-hint" id="cite-export-note"></p>
      </div>
      <div class="modal-btns">
        <button class="modal-btn-cancel" id="cite-export-cancel" type="button">Cancel</button>
        <button class="modal-btn-ok" id="cite-export-go" type="button">Download</button>
      </div>
    </div>
  </div>

  <div id="cite-import-overlay" class="modal-overlay hidden" aria-labelledby="cite-import-title">
    <div class="modal-box">
      <div class="modal-title" id="cite-import-title">Import references</div>
      <div class="modal-body cite-body">
        <label for="cite-import-file">Reference file <span class="settings-hint">(RIS, BibTeX, or CSL-JSON)</span></label>
        <input id="cite-import-file" type="file" accept=".ris,.bib,.json,.txt,application/json,text/plain">
        <label for="cite-import-text">Or paste references</label>
        <textarea id="cite-import-text" rows="6" spellcheck="false" dir="auto" placeholder="Paste RIS, BibTeX, or CSL-JSON here…"></textarea>
        <p class="settings-hint">Each reference becomes a small document in this workspace, so it is searchable and citable like any upload.</p>
        <p id="cite-import-status" class="settings-hint" role="status" aria-live="polite"></p>
      </div>
      <div class="modal-btns">
        <button class="modal-btn-cancel" id="cite-import-cancel" type="button">Cancel</button>
        <button class="modal-btn-ok" id="cite-import-go" type="button">Import</button>
      </div>
    </div>
  </div>

  <!-- Settings modal -->
  <!-- First-run / connection setup. Shown automatically when no model provider is reachable,
       so a new user — or one whose model is offline — is guided straight to connecting one. -->
  <div id="firstrun-overlay" class="modal-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="fr-title">
    <div class="modal-box settings-box">
      <div class="modal-title" id="fr-title"><span aria-hidden="true">◈</span> Connect a model</div>
      <div class="modal-body" style="margin-bottom:14px;">
        Lokyni answers using your own documents, with a model you provide. Choose one to begin — a local model through Ollama, or a hosted model through OpenAI or Anthropic. Your choice is saved on this machine and can be changed later in Settings.
      </div>
      <div class="settings-row">
        <label for="fr-provider">Provider</label>
        <select id="fr-provider">
          <% settingsSchema.providers.forEach(function (p) { %><option value="<%= p.id %>"><%= p.label %><%= p.note ? ' — ' + p.note : '' %></option><% }); %>
        </select>
      </div>
      <div class="settings-row settings-row-full">
        <p id="fr-provider-hint" class="settings-explain" style="margin:2px 0 0;"></p>
      </div>
      <div class="settings-row fr-ollama-row">
        <label for="fr-ollama-host">Ollama host</label>
        <input id="fr-ollama-host" type="text" placeholder="http://localhost:11434" autocomplete="off">
      </div>
      <div class="settings-row fr-ollama-row">
        <label for="fr-ollama-model">Model</label>
        <input id="fr-ollama-model" type="text" placeholder="e.g. llama3.2" autocomplete="off">
      </div>
      <div class="settings-row fr-openai-row hidden">
        <label for="fr-openai-key">API key</label>
        <input id="fr-openai-key" type="password" placeholder="sk-…" autocomplete="off">
      </div>
      <div class="settings-row fr-openai-row hidden">
        <label for="fr-openai-model">Model</label>
        <input id="fr-openai-model" type="text" placeholder="e.g. gpt-4o-mini" autocomplete="off">
      </div>
      <div class="settings-row fr-anthropic-row hidden">
        <label for="fr-anthropic-key">API key</label>
        <input id="fr-anthropic-key" type="password" placeholder="sk-ant-…" autocomplete="off">
      </div>
      <div class="settings-row fr-anthropic-row hidden">
        <label for="fr-anthropic-model">Model</label>
        <input id="fr-anthropic-model" type="text" placeholder="e.g. claude-sonnet-4-5" autocomplete="off">
      </div>
      <div id="fr-status" class="modal-body" role="status" aria-live="polite" aria-atomic="true" style="min-height:18px;margin-top:6px;"></div>
      <div class="modal-btns">
        <button class="modal-btn-cancel" id="fr-skip" type="button">Skip for now</button>
        <button class="modal-btn-ok" id="fr-connect" type="button">Test and connect</button>
      </div>
    </div>
  </div>

  <div id="settings-overlay" class="modal-overlay hidden" aria-labelledby="settings-title">
    <div class="modal-box settings-box">
      <div class="modal-title" id="settings-title"><svg class="ico" aria-hidden="true"><use href="#ic-settings"/></svg> Settings</div>
      <div id="settings-body">
        <div class="settings-search-row">
          <input id="settings-filter" type="search" placeholder="Filter settings…" aria-label="Filter settings" autocomplete="off" spellcheck="false">
          <span id="settings-filter-count" class="settings-hint" role="status" aria-live="polite"></span>
        </div>
        <!-- ── Appearance / accessibility ── -->
        <div class="settings-section">Appearance</div>
        <div class="settings-row">
          <label for="cfg-read-scale">Text size <span class="settings-hint">(makes answers and documents easier to read · applies immediately on this device · the theme is on the toolbar · browser zoom still works)</span></label>
          <select id="cfg-read-scale"></select>
        </div>

        <!-- ── Essentials: the few settings a new user actually sets ── -->
        <div class="settings-section">Model &amp; provider</div>
        <div class="settings-row">
          <label for="cfg-provider">Chat provider</label>
          <select id="cfg-provider">
            <% settingsSchema.providers.forEach(function (p) { %><option value="<%= p.id %>"><%= p.label %></option><% }); %>
          </select>
        </div>
        <div class="settings-row">
          <label for="cfg-model">Chat model</label>
          <input id="cfg-model" type="text" placeholder="e.g. llama3.2, gpt-4o, or claude-sonnet-4-5">
        </div>
        <div class="settings-row">
          <label for="cfg-embeddings-provider">Embeddings provider <span class="settings-hint">(where your documents are embedded &mdash; independent of the chat provider)</span></label>
          <select id="cfg-embeddings-provider">
            <% settingsSchema.embeddingProviders.forEach(function (p) { %><option value="<%= p.id %>"><%= p.label %></option><% }); %>
          </select>
        </div>
        <div class="settings-row settings-row-full">
          <p class="settings-explain"><strong>By default your documents are embedded by a built-in model that runs on this computer</strong> &mdash; no Ollama and no API key needed, fully offline, and it works in many languages. This is only the step that makes your documents <em>searchable</em>. It is not the chat model: <strong>to get written answers you still need a language model</strong> (run Ollama, or add an API key in the chat settings above). You can switch embeddings to Ollama or OpenAI for a different model; embedding and chat are independent, and switching never re-embeds documents a previous model already indexed.</p>
        </div>
        <div class="settings-row">
          <label for="cfg-embeddings">Embeddings model <span class="settings-hint">(must be an embedding model, not a chat model)</span></label>
          <input id="cfg-embeddings" type="text" placeholder="e.g. nomic-embed-text or bge-m3">
        </div>
        <div class="settings-row cfg-embed-banks-only">
          <button id="predict-switch-btn" type="button">Will this re-embed?</button>
          <span id="predict-switch-result" class="settings-hint predict-result" role="status" aria-live="polite"></span>
        </div>
        <div class="settings-row cfg-embed-openai-row">
          <label for="cfg-embed-key">Embeddings API key <span class="settings-hint">(OpenAI-compatible embed endpoint; leave empty to reuse the chat OpenAI key)</span></label>
          <span class="secret-field">
            <input id="cfg-embed-key" type="password" placeholder="leave empty to reuse the chat key">
            <button type="button" class="secret-clear" data-for="cfg-embed-key" title="Remove the stored key">Clear</button>
          </span>
        </div>
        <div class="settings-row cfg-embed-openai-row">
          <label for="cfg-embed-base">Embeddings base URL <span class="settings-hint">(leave empty to reuse the chat OpenAI base URL)</span></label>
          <input id="cfg-embed-base" type="text" placeholder="defaults to the chat OpenAI base URL">
        </div>
        <div class="settings-row settings-row-action cfg-ollama-row">
          <label>Suggested models <span class="settings-hint">(based on this machine)</span></label>
          <button id="cfg-suggest-models" type="button"><svg class="ico" aria-hidden="true"><use href="#ic-generate"/></svg> Suggest models</button>
        </div>
        <div id="cfg-model-suggestions" class="settings-row settings-row-full hidden"></div>
        <div class="settings-row cfg-ollama-row">
          <label for="cfg-ollama-host">Ollama host</label>
          <input id="cfg-ollama-host" type="text" placeholder="http://localhost:11434 or https://ollama.com">
        </div>
        <div class="settings-row cfg-ollama-row">
          <label for="cfg-ollama-key">Ollama API key <span class="settings-hint">(only for Ollama Cloud or a secured host)</span></label>
          <span class="secret-field">
            <input id="cfg-ollama-key" type="password" placeholder="leave empty for local Ollama">
            <button type="button" class="secret-clear" data-for="cfg-ollama-key" title="Remove the stored key">Clear</button>
          </span>
        </div>
        <div class="settings-row cfg-openai-row">
          <label for="cfg-openai-key">OpenAI API key</label>
          <span class="secret-field">
            <input id="cfg-openai-key" type="password" placeholder="sk-…">
            <button type="button" class="secret-clear" data-for="cfg-openai-key" title="Remove the stored key">Clear</button>
          </span>
        </div>
        <div class="settings-row cfg-openai-row">
          <label for="cfg-openai-base">OpenAI base URL</label>
          <input id="cfg-openai-base" type="text" placeholder="https://api.openai.com/v1 (optional)">
        </div>
        <div class="settings-row cfg-anthropic-row">
          <label for="cfg-anthropic-key">Anthropic API key</label>
          <span class="secret-field">
            <input id="cfg-anthropic-key" type="password" placeholder="sk-ant-…">
            <button type="button" class="secret-clear" data-for="cfg-anthropic-key" title="Remove the stored key">Clear</button>
          </span>
        </div>
        <div class="settings-row cfg-anthropic-row">
          <label for="cfg-anthropic-base">Anthropic base URL</label>
          <input id="cfg-anthropic-base" type="text" placeholder="https://api.anthropic.com/v1/ (optional)">
        </div>

        <div class="settings-section">Features</div>
        <div class="settings-row">
          <label for="cfg-web-search">Enable web search <span class="settings-hint">(adds a “Search the web” option to the composer · recommended on · fine-tune under Advanced → Web search options)</span></label>
          <input id="cfg-web-search" type="checkbox">
        </div>
        <div class="settings-row">
          <label for="cfg-url-capture">Web page capture <span class="settings-hint">(Auto fetches plain pages directly and renders only when needed · HTTP only never launches a browser · Browser only always renders)</span></label>
          <select id="cfg-url-capture">
            <% var captureLabels = { auto: 'Auto (recommended)', http: 'HTTP only (no browser)', headless: 'Browser only (always render)' };
               (typeof urlCaptureValues !== 'undefined' ? urlCaptureValues : Object.keys(captureLabels)).forEach(function (v) { %>
              <option value="<%= v %>"><%= captureLabels[v] || v %></option>
            <% }); %>
          </select>
        </div>
        <div class="settings-row">
          <label for="cfg-use-ocr">Read text from scans <span class="settings-hint">(images &amp; scanned PDFs · recommended on · tune under Advanced)</span></label>
          <input id="cfg-use-ocr" type="checkbox">
        </div>
        <div class="settings-row">
          <label for="cfg-query-rewrite">Smart query rewriting <span class="settings-hint">(understands follow-up questions · recommended on)</span></label>
          <input id="cfg-query-rewrite" type="checkbox">
        </div>
        <div class="settings-row">
          <label for="cfg-conv-summary">Conversation summary memory <span class="settings-hint">(recalls earlier turns · recommended on)</span></label>
          <input id="cfg-conv-summary" type="checkbox">
        </div>
        <div class="settings-row">
          <label for="cfg-intent-classifier">Model-based follow-up handling <span class="settings-hint">(one small model call per turn · off uses built-in heuristics)</span></label>
          <input id="cfg-intent-classifier" type="checkbox">
        </div>
        <div class="settings-row">
          <label for="cfg-suggested-questions">Offer follow-up questions <span class="settings-hint">(master switch · the composer's Follow-ups option turns them on for a session)</span></label>
          <input id="cfg-suggested-questions" type="checkbox">
        </div>

        <div class="settings-section">Voice &amp; audio</div>
        <div class="settings-row">
          <label for="cfg-tts-enabled">Read answers aloud <span class="settings-hint">(a local voice for English; other languages use your system voices · first use downloads a ~90 MB voice model)</span><span class="voice-status" id="cfg-tts-status"></span></label>
          <input id="cfg-tts-enabled" type="checkbox">
        </div>
        <div class="settings-row hidden settings-row-voices" id="cfg-tts-voice-row">
          <label for="cfg-tts-voice">English voice <span class="settings-hint">(the bundled local model)</span></label>
          <span class="voice-pick">
            <span class="voice-pair"><select id="cfg-tts-voice"></select><button type="button" id="cfg-tts-preview" class="voice-preview" title="Preview this voice"><svg class="ico" aria-hidden="true"><use href="#ic-play"/></svg></button></span>
          </span>
        </div>
        <div class="settings-row hidden" id="cfg-tts-speed-row">
          <label for="cfg-tts-speed">Speed <span class="settings-hint" id="cfg-tts-speed-val">(1.0×)</span></label>
          <input id="cfg-tts-speed" type="range" data-setting="ttsSpeed">
        </div>
        <div class="settings-row hidden" id="cfg-tts-language-row">
          <label for="cfg-tts-language">Read-aloud language <span class="settings-hint">(Automatic matches each answer; other languages use a system voice)</span></label>
          <select id="cfg-tts-language"></select>
        </div>
        <div class="settings-row hidden settings-row-voices settings-row-voices-stacked" id="cfg-tts-system-voice-row">
          <label for="cfg-tts-system-language">System voice <span class="settings-hint">(pin a voice per language; Automatic uses the best local one)</span></label>
          <span class="voice-pick">
            <span class="voice-field">
              <span class="voice-field-label" aria-hidden="true">Language</span>
              <span class="voice-pair"><select id="cfg-tts-system-language" aria-label="System voice language"></select></span>
            </span>
            <span class="voice-field">
              <span class="voice-field-label" aria-hidden="true">Voice</span>
              <span class="voice-pair"><select id="cfg-tts-system-voice" aria-label="Installed system voice"></select><button type="button" id="cfg-tts-system-preview" class="voice-preview" title="Preview this system voice" aria-label="Preview this system voice" aria-describedby="cfg-tts-system-status"><svg class="ico" aria-hidden="true"><use href="#ic-play"/></svg></button></span>
            </span>
          </span>
          <p class="settings-hint voice-status voice-status-block" id="cfg-tts-system-status"></p>
        </div>
        <div class="settings-row hidden" id="cfg-tts-online-voices-row">
          <label for="cfg-tts-online-voices">Allow online voices <span class="settings-hint">(some system voices use a network service · off keeps read-aloud local wherever your device has a voice)</span></label>
          <input id="cfg-tts-online-voices" type="checkbox">
        </div>
        <details class="settings-collapsible" id="cfg-tts-voices-details" hidden>
          <summary>Installed voices <span class="settings-hint">(what this device can speak · local vs online)</span></summary>
          <div id="cfg-tts-voices-list" class="tts-voices-list" role="list" aria-label="Installed voices by language" aria-describedby="cfg-tts-voices-note" tabindex="0"></div>
          <p id="cfg-tts-voices-note" class="settings-hint"></p>
        </details>
        <div class="settings-row hidden settings-row-voices" id="cfg-podcast-voices-row">
          <label>Podcast hosts <span class="settings-hint">(Audio Overview — two voices)</span></label>
          <span class="voice-pick">
            <span class="voice-pair"><select id="cfg-podcast-voice-a" aria-label="Podcast host A voice"></select><button type="button" id="cfg-podcast-preview-a" class="voice-preview" title="Preview host A"><svg class="ico" aria-hidden="true"><use href="#ic-play"/></svg></button></span>
            <span class="voice-pair"><select id="cfg-podcast-voice-b" aria-label="Podcast host B voice"></select><button type="button" id="cfg-podcast-preview-b" class="voice-preview" title="Preview host B"><svg class="ico" aria-hidden="true"><use href="#ic-play"/></svg></button></span>
          </span>
        </div>
        <div class="settings-row">
          <label for="cfg-stt-enabled">Ask questions by voice <span class="settings-hint">(a microphone button · first use downloads a ~75 MB model)</span><span class="voice-status" id="cfg-stt-status"></span></label>
          <input id="cfg-stt-enabled" type="checkbox">
        </div>
        <div class="settings-row hidden" id="cfg-stt-language-row">
          <label for="cfg-stt-language">Spoken language</label>
          <select id="cfg-stt-language"></select>
        </div>
        <div class="settings-row hidden" id="cfg-mic-device-row">
          <label for="cfg-mic-device">Microphone <span class="settings-hint">(the input device for voice &amp; hands-free · allow mic access once to see device names)</span></label>
          <select id="cfg-mic-device"></select>
        </div>
        <div class="settings-row">
          <label for="cfg-audio-ingest">Transcribe audio &amp; video <span class="settings-hint">(index what is spoken in media files · WAV works instantly, other formats fetch a decoder once)</span></label>
          <input id="cfg-audio-ingest" type="checkbox">
        </div>
        <div class="settings-row hidden" id="cfg-audio-minutes-row">
          <label for="cfg-audio-minutes">Transcribe up to (minutes per file) <span class="settings-hint">(caps long recordings)</span></label>
          <input id="cfg-audio-minutes" type="number" data-setting="audioMaxMinutes">
        </div>

        <!-- ── Advanced: tuning knobs most users never need to touch ── -->
        <details class="settings-advanced settings-collapsible">
          <summary>Advanced <span class="settings-hint">(tuning — the defaults suit most setups)</span></summary>

          <div class="settings-section">Generation</div>
          <div class="settings-row">
            <label for="cfg-temperature">Temperature</label>
            <input id="cfg-temperature" type="number" data-setting="temperature">
          </div>
          <div class="settings-row">
            <label for="cfg-max-tokens">Max answer length <span class="settings-hint">(leave blank for Auto — sized to your model so long answers aren't cut off; or set a token cap)</span></label>
            <input id="cfg-max-tokens" type="number" data-setting="maxTokens" placeholder="Auto">
          </div>
          <div class="settings-row">
            <label for="cfg-num-ctx">Context window (tokens) <span class="settings-hint">(leave blank for automatic — detected per model and capped for memory safety · set a value to override)</span></label>
            <input id="cfg-num-ctx" type="number" data-setting="numCtx" placeholder="auto">
          </div>
          <div class="settings-row">
            <label for="cfg-max-history">Max history turns</label>
            <input id="cfg-max-history" type="number" data-setting="maxHistory">
          </div>

          <div class="settings-section">Conversation</div>
          <div class="settings-row">
            <label for="cfg-meta-conversation">Answer questions about the conversation <span class="settings-hint">(“what did I just ask?” · answered from history, no document search)</span></label>
            <input id="cfg-meta-conversation" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-topic-switch-ack">Announce topic switches <span class="settings-hint">(a short “Switching to…” acknowledgment when the subject changes)</span></label>
            <input id="cfg-topic-switch-ack" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-clarifying-questions">Ask a clarifying question <span class="settings-hint">(only when a reference is genuinely ambiguous)</span></label>
            <input id="cfg-clarifying-questions" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-partial-match">Keep partial matches <span class="settings-hint">(offer the closest passages when they only partly match, rather than a hard refusal)</span></label>
            <input id="cfg-partial-match" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-semantic-cache">Reuse answers for exact repeats <span class="settings-hint">(a repeated question against an unchanged corpus returns the stored answer instantly)</span></label>
            <input id="cfg-semantic-cache" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-show-confidence">Show answer confidence <span class="settings-hint">(a high, medium, or low verdict on each answer, blended from the signals already computed)</span></label>
            <input id="cfg-show-confidence" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-abstain-weak">Caution on weak evidence <span class="settings-hint">(lead a low-confidence answer with an honest note; the answer itself is unchanged)</span></label>
            <input id="cfg-abstain-weak" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-semantic-entropy">Check answer stability <span class="settings-hint">(re-ask a few times and flag an answer that changes; adds model calls, so it is off by default)</span></label>
            <input id="cfg-semantic-entropy" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-semantic-entropy-samples">Stability samples <span class="settings-hint">(how many times to re-ask when stability checking is on)</span></label>
            <input id="cfg-semantic-entropy-samples" type="number" data-setting="semanticEntropySamples">
          </div>

          <div class="settings-section">Retrieval</div>
          <div class="settings-row">
            <label for="cfg-passage-size">Passage size (chars)</label>
            <input id="cfg-passage-size" type="number" data-setting="passageSize">
          </div>
          <div class="settings-row">
            <label for="cfg-embedding-context">Embedding context window <span class="settings-hint">(tokens the embedding model accepts · 2048 suits the default · lower it for a smaller model · re-index to apply)</span></label>
            <input id="cfg-embedding-context" type="number" data-setting="embeddingContextTokens" placeholder="auto">
          </div>
          <div class="settings-row">
            <label for="cfg-contextual-retrieval">Add context to each chunk <span class="settings-hint">(sharper search; slower indexing. Rebuild to apply to existing docs.)</span></label>
            <input id="cfg-contextual-retrieval" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-reranker">Cross-encoder re-ranking <span class="settings-hint">(re-scores retrieved passages with a small local model · ~23 MB one-time download · recommended on)</span></label>
            <input id="cfg-reranker" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-colbert-rerank">Token-level re-ranking (second pass) <span class="settings-hint">(an additional, slower ranking pass over the top passages · small model, downloads once)</span></label>
            <input id="cfg-colbert-rerank" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-embedding-banks">Keep separate indexes per embedding model <span class="settings-hint">(old documents stay searchable when you switch models · applies on restart)</span></label>
            <input id="cfg-embedding-banks" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-corrective-retrieval">Retry weak matches <span class="settings-hint">(on a weak match, rephrase and search again before answering.)</span></label>
            <input id="cfg-corrective-retrieval" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-cross-lingual">Answer across languages <span class="settings-hint">(find a document even when you ask in a different language than the one it is written in.)</span></label>
            <input id="cfg-cross-lingual" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-document-summaries">Summarize each document for broad questions <span class="settings-hint">(helps "what's this about" and "common themes" questions. Rebuild to apply.)</span></label>
            <input id="cfg-document-summaries" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-auto-synthesis">Answer whole-corpus questions <span class="settings-hint">(synthesizes across the workspace for "common themes across all my documents". Can be slow on large workspaces.)</span></label>
            <input id="cfg-auto-synthesis" type="checkbox">
          </div>
          <div class="settings-section-note">Recall boosters — find more passages, at some extra cost per question.</div>
          <div class="settings-row">
            <label for="cfg-rag-fusion">Search more phrasings <span class="settings-hint">(searches a few wordings of each question and merges the results.)</span></label>
            <input id="cfg-rag-fusion" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-hyde">Search with a draft answer too <span class="settings-hint">(also searches using a hypothetical answer passage. The draft is never shown.)</span></label>
            <input id="cfg-hyde" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-entity-graph">Connect ideas across documents <span class="settings-hint">(for "how are X and Y related" questions, also searches the entities that link them.)</span></label>
            <input id="cfg-entity-graph" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-graph-rag">Knowledge graph — deeper connections <span class="settings-hint">(reads each document once to map entities and how they relate, for multi-step "how are X and Y connected" questions. Builds automatically when you turn it on, then stays current in the background as documents change.)</span></label>
            <input id="cfg-graph-rag" type="checkbox">
          </div>
          <div class="settings-row settings-row-full hidden" id="cfg-graph-rag-actions">
            <button type="button" id="btn-build-graph" class="danger-btn">Rebuild knowledge graph</button>
            <span class="settings-hint" id="graph-rag-status" role="status" aria-live="polite" aria-atomic="true"></span>
          </div>
          <div class="settings-row">
            <label for="cfg-adaptive-retrieval">Use boosters only when needed <span class="settings-hint">(runs the recall boosters above only for involved questions. Simple lookups stay fast.)</span></label>
            <input id="cfg-adaptive-retrieval" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-rewrite-model">Follow-up model <span class="settings-hint">(default: same as chat model)</span></label>
            <input id="cfg-rewrite-model" type="text" placeholder="(same as chat model)">
          </div>

          <div class="settings-section">Web search options</div>
          <div class="settings-row">
            <label for="cfg-web-autosuggest">Auto-suggest web on no match <span class="settings-hint">(ask first · recommended on)</span></label>
            <input id="cfg-web-autosuggest" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-web-ranking">Rank web results by source <span class="settings-hint">(authority, relevance, recency · recommended on)</span></label>
            <input id="cfg-web-ranking" type="checkbox">
          </div>
          <div class="settings-row settings-row-full">
            <label for="cfg-web-proxy">Outbound proxy <span class="settings-hint">(optional. Routes web search, page fetches, and URL ingestion. Use http, https, or socks. One per line for a rotating pool. Blank = direct.)</span></label>
            <textarea id="cfg-web-proxy" rows="2" placeholder="http://host:port  or  socks5://host:port  (one per line; blank = direct)" autocomplete="off" spellcheck="false"></textarea>
          </div>
          <div class="settings-row">
            <label for="cfg-web-proxy-rotate">Rotate proxies <span class="settings-hint">(off by default · when on, round-robin across the listed proxies each request · otherwise the first is used)</span></label>
            <input id="cfg-web-proxy-rotate" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-web-proxy-retries">Proxy retries <span class="settings-hint">(when a proxy is blocked, retry through the next one this many times · 0 = no retry)</span></label>
            <input id="cfg-web-proxy-retries" type="number" data-setting="webProxyRetries" placeholder="auto">
          </div>
          <div class="settings-row">
            <label for="cfg-web-proxy-strict">Strict proxy <span class="settings-hint">(off by default · when on, a web request fails rather than connecting directly if the proxy can't be used — never exposes your real IP)</span></label>
            <input id="cfg-web-proxy-strict" type="checkbox">
          </div>

          <div class="settings-section">Scanned documents (OCR)</div>
          <div class="settings-row settings-row-full">
            <p class="settings-explain">
              Scanned PDFs and photos have no text layer, so nothing can be read from
              them &mdash; they index as empty and never appear in answers. Reading the
              text off the page (toggle under Features) fixes that, at a cost of a few
              seconds per page. These options fine-tune how it's done.
            </p>
          </div>
          <div class="settings-row cfg-ocr-row">
            <label for="cfg-ocr-engine">Method</label>
            <select id="cfg-ocr-engine">
            <% var ocrEngineLabels = { tesseract: 'Built-in — fast, works immediately', vision: 'Vision model — better on messy scans' };
               (typeof ocrEngineValues !== 'undefined' ? ocrEngineValues : Object.keys(ocrEngineLabels)).forEach(function (v) { %>
              <option value="<%= v %>"><%= ocrEngineLabels[v] || v %></option>
            <% }); %>
            </select>
          </div>
          <div class="settings-row settings-row-full cfg-ocr-row">
            <p id="ocr-engine-note" class="settings-explain"></p>
          </div>
          <div class="settings-row cfg-ocr-row cfg-ocr-vision-row">
            <label for="cfg-ocr-model">OCR vision model <span class="settings-hint">(reads the text off the page)</span></label>
            <input id="cfg-ocr-model" type="text" placeholder="e.g. minicpm-v or llama3.2-vision">
          </div>
          <div class="settings-row settings-row-full cfg-ocr-row cfg-ocr-vision-row">
            <p class="settings-explain">The model used to <strong>transcribe</strong> text from scans when Method is set to Vision. Use a model that's strong at document OCR &mdash; <code>minicpm-v</code> or <code>llama3.2-vision</code> read dense pages (IDs, forms, tables) far better than small models. Small captioning models like <code>moondream</code> tend to summarize instead of transcribing every field, so they're a poor fit here. Must be pulled in Ollama first (e.g. <code>ollama pull minicpm-v</code>).</p>
          </div>
          <div class="settings-row cfg-ocr-row">
            <label for="cfg-ocr-max-pages">Max pages per document <span class="settings-hint">(keeps long scans from stalling)</span></label>
            <input id="cfg-ocr-max-pages" type="number" data-setting="ocrMaxPages">
          </div>
          <div class="settings-row cfg-ocr-row cfg-ocr-tess-row">
            <label for="cfg-ocr-workers">Pages at once <span class="settings-hint">(higher is faster, uses more memory and CPU)</span></label>
            <select id="cfg-ocr-workers">
              <option value="">Automatic</option>
              <option value="1">1 &mdash; slowest, gentlest on the machine</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
              <option value="6">6 &mdash; only on a machine with cores to spare</option>
              <option value="8">8 &mdash; maximum</option>
            </select>
          </div>
          <div class="settings-row settings-row-full cfg-ocr-row cfg-ocr-tess-row">
            <p id="ocr-workers-note" class="settings-explain"></p>
          </div>
          <div class="settings-row settings-row-full cfg-ocr-row cfg-ocr-tess-row">
            <div class="settings-subhead" id="cfg-ocr-languages-label">Also read these languages <span class="settings-hint">(English is always read · choose up to 4 · each pack downloads once, then works offline)</span></div>
            <div id="cfg-ocr-languages" class="settings-language-grid" role="group" aria-labelledby="cfg-ocr-languages-label"></div>
            <p id="ocr-languages-note" class="settings-explain" role="status" aria-live="polite"></p>
          </div>

          <div class="settings-section">Describe images</div>
          <div class="settings-row">
            <label for="cfg-vision-describe">Describe images with no text <span class="settings-hint">(optional — make photos, diagrams, and screenshots findable by what they show)</span></label>
            <input id="cfg-vision-describe" type="checkbox">
          </div>
          <div class="settings-row settings-row-full cfg-vision-row">
            <p class="settings-explain">When on, images with no extractable text (photos, diagrams, charts, screenshots) are described by a vision model so they're findable by what they show. Needs a vision model pulled in Ollama (e.g. <code>qwen2.5vl:7b</code>, <code>llava:13b</code>, <code>moondream</code>). Vision models are heavy — leave this off if your machine can't spare the resources; OCR is unaffected either way.</p>
          </div>
          <div class="settings-row settings-row-stacked cfg-vision-row">
            <label>Describe vision model <span class="settings-hint">(captions text-free images)</span></label>
            <div class="settings-input-stack">
              <select id="cfg-vision-model"><option value="">(choose a model)</option></select>
              <input id="cfg-vision-model-text" type="text" placeholder="or type a model name, e.g. qwen2.5vl:7b">
            </div>
          </div>
          <div class="settings-row">
            <label for="cfg-visual-ingest">Describe figures &amp; tables in PDFs <span class="settings-hint">(optional — make charts and tables searchable)</span></label>
            <input id="cfg-visual-ingest" type="checkbox">
          </div>
          <div class="settings-row settings-row-full cfg-vision-row">
            <p class="settings-explain">When on, the vision model above describes the figures, charts, and tables in your documents — so a chart's takeaway or a table's data becomes searchable ("the revenue table", "what the trend chart shows"). For PDFs each page is read; for Word and PowerPoint, embedded images are read (there is no page renderer for those). It adds a vision call per page or image (slow on large files), and very large files are left to the text path. Re-index to apply it to documents already indexed.</p>
          </div>
          <div class="settings-row cfg-visual-crop-row">
            <label for="cfg-visual-crop">Crop figure thumbnails <span class="settings-hint">(show each figure/table on the cited source)</span></label>
            <input id="cfg-visual-crop" type="checkbox">
          </div>
          <div class="settings-row settings-row-full cfg-visual-crop-row">
            <p class="settings-explain">When on, each detected figure or table is cropped into a thumbnail and shown on the source when it's cited. The vision model is asked for each figure's location on the page; a figure with no clear location is still described in text, just without a thumbnail. Thumbnails are stored alongside the index and included in a workspace backup.</p>
          </div>

          <div class="settings-section">Security</div>
          <div class="settings-row">
            <label for="cfg-audit-log">Security audit log <span class="settings-hint">(tamper-evident record of key, config &amp; access events · view under Logs → Audit · recommended on)</span></label>
            <input id="cfg-audit-log" type="checkbox">
          </div>
          <div class="settings-row">
            <label for="cfg-allow-network">Allow access from other devices on your network <span class="settings-hint">(off by default — Lokyni is private to this computer · takes effect after a restart)</span></label>
            <input id="cfg-allow-network" type="checkbox">
          </div>
          <div class="settings-row settings-row-full hidden" id="cfg-network-note">
            <p class="settings-explain">With this on, anyone who can reach this computer on your network can open Lokyni and your documents — so it requires an <strong>account</strong> to sign in (set one up under <em>Accounts</em>). You can also create <strong>API keys</strong> for programmatic access. Leave it off to keep Lokyni private to this computer. Takes effect after you restart Lokyni.</p>
          </div>

          <div class="settings-section">Diagnostics</div>
          <div class="settings-row">
            <label for="cfg-debug">Verbose logging <span class="settings-hint">(detailed diagnostics for troubleshooting · view and Copy under Logs · takes effect after a restart)</span></label>
            <input id="cfg-debug" type="checkbox">
          </div>
          <div class="settings-row settings-row-full">
            <p class="settings-explain">Turn this on to capture detailed diagnostics when reporting a problem. Restart the app for it to take effect, reproduce the issue, then open Logs and use Copy to share the output. Leave it off for normal use — it makes the logs much larger.</p>
          </div>
        </details>

        <!-- ── Tools & data: maintenance and integrations, not day-to-day settings ──
             Collapsed by default (like Advanced) so opening Settings shows the core setup first and
             this heavy management suite — rebuild, API keys, clipper, connectors, templates,
             automations, email, evaluation — stays out of the way until a user goes looking for it. -->
        <details class="settings-advanced settings-collapsible">
          <summary>Tools &amp; data <span class="settings-hint">(maintenance &amp; integrations)</span></summary>
        <div class="settings-section">Maintenance</div>
        <div class="settings-row settings-row-full">
          <label class="settings-subhead">Rebuild index</label>
        </div>
        <div class="settings-row settings-row-full">
          <p class="settings-explain">Wipes the search index and rebuilds it from scratch by re-reading every document. Use this if search or related documents behave oddly — for example after moving your documents folder. Your documents themselves are never touched, only the index Lokyni builds from them.</p>
        </div>
        <div class="settings-row">
          <button id="rebuild-index-btn" class="danger-btn" type="button">Rebuild index…</button>
          <span id="rebuild-index-status" class="settings-hint" role="status" aria-live="polite" aria-atomic="true"></span>
        </div>
        <div id="cfg-bank-state-row" class="settings-row settings-row-full hidden">
          <div id="cfg-bank-state" class="bank-state" role="status" aria-live="polite"></div>
        </div>
        <div id="consolidate-banks-row" class="settings-row settings-row-full hidden">
          <p class="settings-explain">You've changed the embeddings model, so your documents are spread across more than one embedding bank. <strong>Consolidate</strong> re-embeds everything with the current model into a single bank and frees the space the old ones used. It re-embeds the whole corpus, so it can take a while.</p>
        </div>
        <div id="consolidate-banks-btnrow" class="settings-row hidden">
          <button id="consolidate-banks-btn" class="danger-btn" type="button">Consolidate embedding banks…</button>
          <span id="consolidate-banks-status" class="settings-hint" role="status" aria-live="polite" aria-atomic="true"></span>
        </div>

        <div class="settings-section">Integrations &amp; API access</div>
        <div class="settings-row settings-row-full">
          <label class="settings-subhead">API keys <span class="settings-hint">(for using Lokyni's API outside this app)</span></label>
        </div>
        <div class="settings-row settings-row-full">
          <p class="settings-explain">Create a key to call the <code>/api/v1</code> endpoints (search, summarize, list) from scripts or other tools. The key is shown once — copy it then. Keys matter most if you expose Lokyni beyond localhost.</p>
        </div>
        <div class="settings-row settings-row-full">
          <div id="apikey-list" class="apikey-list"></div>
        </div>
        <div class="settings-row settings-row-full">
          <div class="apikey-create">
            <input id="apikey-name" type="text" aria-label="API key name" placeholder="Key name (e.g. my-script)" maxlength="64">
            <div class="apikey-scopes">
              <span class="apikey-scopes-label">Scopes:</span>
              <!-- Rendered from the server's scope list (authz.apiKeyScopeList) so the picker can never drift from
                   the scopes the server actually honors. See renderApiKeyScopes in chat.js. -->
              <span id="apikey-scope-list"></span>
            </div>
            <div class="apikey-workspaces">
              <span class="apikey-scopes-label">Workspaces:</span>
              <div id="apikey-ws-list" class="apikey-ws-list"></div>
              <span class="settings-hint">Leave all unchecked to allow <strong>every</strong> workspace, including ones added later. Check specific workspaces to limit this key to them.</span>
            </div>
            <div class="apikey-rate">
              <label>Rate limit:
                <input id="apikey-rate" type="number" min="0" step="1" placeholder="120" style="width:70px;">
                <span class="settings-hint">requests/min · blank = default 120 · 0 = unlimited</span>
              </label>
            </div>
            <button id="apikey-create-btn" type="button">Create key</button>
          </div>
          <div id="apikey-new" class="apikey-new hidden"></div>
        </div>

        <div class="settings-row settings-row-full">
          <label class="settings-subhead">Browser clipper <span class="settings-hint">(save the page you're reading into Lokyni)</span></label>
        </div>
        <div class="settings-row settings-row-full">
          <p class="settings-explain">Create a clipper, then drag the button to your bookmarks bar. Click it on any page — including pages you're logged into — to save that page into Lokyni. It reads the page your browser has already loaded, so it works behind logins without sharing your passwords. Creating a clipper makes a dedicated <code>write</code>-scoped API key; the bookmarklet is shown once, so drag it to your bookmarks before closing.</p>
        </div>
        <div class="settings-row">
          <button id="clipper-create-btn" class="danger-btn" type="button">Create clipper bookmarklet</button>
          <span class="settings-hint" id="clipper-hint"></span>
        </div>
        <div class="settings-row settings-row-full">
          <div id="clipper-result" class="clipper-result hidden">
            <a id="clipper-bookmarklet" class="clipper-drag" href="#">◇ Clip to Lokyni</a>
            <span class="settings-hint">← Drag this to your bookmarks bar</span>
          </div>
        </div>

        <div class="settings-row settings-row-full">
          <label class="settings-subhead">Connectors <span class="settings-hint">(pull documents in from an MCP source)</span></label>
        </div>
        <div class="settings-row settings-row-full">
          <p class="settings-explain">Connect an MCP server as an ingestion source for this workspace. Lokyni pulls its documents in and indexes them; re-sync to refresh. The <strong>filesystem</strong> connector points at a folder (runs locally, nothing leaves your machine); the <strong>GitHub</strong> connector pulls a repository's text files (public repos need no token, private repos take a personal access token).</p>
        </div>
        <div class="settings-row settings-row-full">
          <div id="connector-list" class="apikey-list"></div>
        </div>
        <div class="settings-row settings-row-full">
          <div class="apikey-create">
            <div class="connector-fields">
              <label>Type:
                <select id="connector-type">
                  <option value="filesystem">Folder (filesystem)</option>
                  <option value="obsidian">Obsidian vault</option>
                  <option value="github">GitHub repository</option>
                </select>
              </label>
              <input id="connector-name" type="text" aria-label="Connector name" placeholder="Name (e.g. project-docs)" maxlength="64">
            </div>
            <div class="connector-fields" id="connector-config-filesystem">
              <label id="connector-path-label">Folder path:
                <input id="connector-fs-path" type="text" placeholder="/Users/you/Documents/notes" class="connector-input">
                <button id="connector-browse-btn" type="button" class="picker-primary" style="padding:4px 10px;">Browse…</button>
              </label>
              <p class="settings-hint connector-help">The full path to a folder on this machine — starting from the root (<code>/</code>), or use <strong>Browse…</strong> to pick one. Lokyni pulls the text files inside it (and subfolders) into this workspace. Dependency and build folders (<code>node_modules</code>, <code>.git</code>, <code>dist</code>, <code>venv</code>, etc.) are skipped automatically.</p>
            </div>
            <div class="connector-fields" id="connector-config-github" style="display:none;">
              <label>Owner:
                <input id="connector-gh-owner" type="text" placeholder="octocat" class="connector-input">
              </label>
              <label>Repository:
                <input id="connector-gh-repo" type="text" placeholder="Hello-World" class="connector-input">
              </label>
              <label>Branch:
                <input id="connector-gh-branch" type="text" placeholder="(default)" class="connector-input">
              </label>
              <label>Token:
                <input id="connector-gh-token" type="password" placeholder="ghp_… (only for private repos)" class="connector-input" autocomplete="off">
              </label>
              <p class="settings-hint">Lokyni pulls the repository's text files (Markdown, source, config — same types and skip-rules as a folder) into this workspace via the official GitHub MCP server. A <strong>public</strong> repo needs no token. A <strong>private</strong> repo, or higher rate limits, needs a GitHub <a href="https://github.com/settings/tokens" target="_blank" rel="noopener">personal access token</a> with <code>repo</code> read scope — it's stored locally and never shown again.</p>
            </div>
            <div class="connector-fields">
              <label>Server package <span class="settings-hint">(advanced)</span>:
                <input id="connector-package" type="text" placeholder="(latest)" class="connector-input" autocomplete="off">
              </label>
              <p class="settings-hint">Optional. By default Lokyni runs the latest official MCP server for this connector. To pin a version for supply-chain certainty — or to repoint at a replacement — enter an npm package spec such as <code>@modelcontextprotocol/server-filesystem@2025.1.0</code>. Leave blank to track the latest release.</p>
            </div>
            <button id="connector-add-btn" type="button">Add connector</button>
          </div>
        </div>

        <div class="settings-section">Prompts &amp; automation</div>
        <div class="settings-row settings-row-full">
          <label class="settings-subhead">Prompt templates <span class="settings-hint">(reusable prompts — type <code>/</code> in the chat box to insert one)</span></label>
        </div>
        <div class="settings-row settings-row-full">
          <p class="settings-explain">Save prompts you use often. In the chat box, type <code>/</code> then part of a template's name to insert it. Bodies may contain <code>{variables}</code>: <code>{date}</code>, <code>{time}</code>, and <code>{workspace}</code> fill in automatically; any other <code>{name}</code> becomes a placeholder the composer selects so you can type over it.</p>
        </div>
        <div class="settings-row settings-row-full">
          <div id="template-list" class="apikey-list"></div>
        </div>
        <div class="settings-row settings-row-full">
          <div class="apikey-create">
            <input id="template-name" type="text" aria-label="Prompt template name" placeholder="Name (e.g. Extract action items)" maxlength="80" style="width:230px;">
            <textarea id="template-body" placeholder="Prompt body — e.g. List every action item and owner about {topic}." rows="2" style="width:100%;margin-top:6px;"></textarea>
            <button id="template-add-btn" type="button" style="margin-top:6px;">Add template</button>
            <button id="template-restore-btn" type="button" style="margin-top:6px;margin-left:8px;">Restore built-in templates</button>
          </div>
        </div>

        <div class="settings-row settings-row-full">
          <label class="settings-subhead">Automations <span class="settings-hint">(run a query on a schedule; results land in your Inbox)</span></label>
        </div>
        <div class="settings-row settings-row-full">
          <p class="settings-explain">Schedule a saved question or a workspace digest to run automatically for the <strong>active workspace</strong>. Results are delivered to the in-app <strong>Inbox</strong> (nothing leaves your machine), and optionally emailed if SMTP is configured in <code>config.json</code>. A digest only notifies you when the workspace's documents have changed. Jobs run while Lokyni is running, in the server's local time.</p>
        </div>
        <div class="settings-row settings-row-full">
          <div id="automation-list" class="apikey-list"></div>
        </div>
        <div class="settings-row settings-row-full">
          <div class="apikey-create">
            <div class="connector-fields">
              <label>Type:
                <select id="automation-kind">
                  <option value="query">Saved question</option>
                  <option value="digest">Workspace digest</option>
                </select>
              </label>
              <input id="automation-name" type="text" aria-label="Automation name" placeholder="Name (optional)" maxlength="80" style="width:170px;">
            </div>
            <div class="connector-fields">
              <input id="automation-query" type="text" aria-label="Question to ask" placeholder="Question to ask (for a saved question)" style="width:100%;">
            </div>
            <div class="connector-fields">
              <label>Schedule:
                <!-- Options are populated from SCHEDULE_PRESETS in chat.js (single source for cron + label). -->
                <select id="automation-schedule-preset"></select>
              </label>
              <input id="automation-schedule-custom" type="text" aria-label="Custom cron schedule" placeholder="cron e.g. 30 7 * * 1-5" style="width:150px;display:none;">
              <label>Email (optional):
                <input id="automation-email" type="email" placeholder="you@example.com" style="width:180px;" autocomplete="off">
              </label>
            </div>
            <p class="settings-hint" id="automation-cron-warning" style="display:none;color:var(--warn-text);">Scheduler unavailable — <code>node-cron</code> isn't installed. Run <code>npm install</code>.</p>
            <button id="automation-add-btn" type="button">Add automation</button>
          </div>
        </div>

        <div class="settings-row settings-row-full">
          <label class="settings-subhead">Email (SMTP) <span class="settings-hint">(optional — lets automations email their results)</span></label>
        </div>
        <div class="settings-row settings-row-full">
          <p class="settings-explain">Set this only if you want automation digests <strong>emailed</strong> in addition to the in-app Inbox. Everything works without it. The password is stored locally and never shown again — leave it blank when saving to keep the existing one.</p>
        </div>
        <div class="settings-row settings-row-full">
          <div class="apikey-create">
            <div class="connector-fields">
              <label>Host: <input id="smtp-host" type="text" placeholder="smtp.example.com" style="width:180px;"></label>
              <label>Port: <input id="smtp-port" type="number" placeholder="587" style="width:80px;"></label>
              <label>Encryption:
                <select id="smtp-secure">
                  <option value="false">STARTTLS (587)</option>
                  <option value="true">SSL/TLS (465)</option>
                </select>
              </label>
            </div>
            <div class="connector-fields">
              <label>Username: <input id="smtp-user" type="text" placeholder="you@example.com" style="width:180px;" autocomplete="off"></label>
              <label>Password: <input id="smtp-pass" type="password" placeholder="SMTP password" style="width:180px;" autocomplete="new-password"></label>
            </div>
            <div class="connector-fields">
              <label>From: <input id="smtp-from" type="text" placeholder="Lokyni &lt;you@example.com&gt;" style="width:260px;"></label>
            </div>
            <div class="connector-fields">
              <button id="smtp-save-btn" type="button">Save SMTP</button>
              <label>Send test to: <input id="smtp-test-to" type="email" placeholder="you@example.com" style="width:180px;" autocomplete="off"></label>
              <button id="smtp-test-btn" type="button" class="picker-primary" style="padding:4px 12px;">Send test email</button>
            </div>
            <p class="settings-hint" id="smtp-test-result" style="display:none;" role="status" aria-live="polite" aria-atomic="true"></p>
          </div>
        </div>

        <div class="settings-section">Quality</div>
        <div class="settings-row settings-row-full">
          <label class="settings-subhead">Quality evaluation <span class="settings-hint">(measure retrieval quality on your own documents; nothing leaves your machine)</span></label>
        </div>
        <div class="settings-row settings-row-full">
          <p class="settings-explain">Save a few representative questions for this workspace, then run the evaluation to score the answers on <strong>faithfulness</strong> (are the claims backed by the sources), <strong>answer relevancy</strong> (does it address the question), and <strong>context precision</strong> (were the retrieved passages on-topic). Each run shows the change since the last one, so you can tell whether a model or setting change helped. It uses your own model and never runs on its own.</p>
        </div>
        <div class="settings-row settings-row-full">
          <div class="apikey-create">
            <div id="eval-question-list" class="apikey-list"></div>
            <div class="connector-fields">
              <input id="eval-question-input" type="text" aria-label="New evaluation question" placeholder="A representative question to test…" style="width:100%;" maxlength="2000">
            </div>
            <div class="connector-fields">
              <button id="eval-add-btn" type="button">Add question</button>
              <button id="eval-seed-btn" type="button" title="Propose a few representative questions from your documents">Suggest from my documents</button>
              <button id="eval-run-btn" type="button" class="picker-primary" style="padding:4px 12px;">Run evaluation</button>
              <span id="eval-status" class="settings-hint" role="status" aria-live="polite" aria-atomic="true" style="display:none;"></span>
            </div>
            <div id="eval-results"></div>
            <div id="eval-trend"></div>
            <div id="eval-compare"></div>
          </div>
        </div>
        </details>

        <div class="settings-section">Health</div>
        <details class="settings-collapsible" id="cfg-health-details">
          <summary>Integrity checks <span class="settings-hint">(read-only · latest sweep)</span></summary>
          <div id="cfg-health-list" class="health-list" role="list" aria-label="Health findings" tabindex="0"></div>
          <p id="cfg-health-note" class="settings-hint" role="status" aria-live="polite"></p>
        </details>

        <div id="settings-status" role="status" aria-live="polite" aria-atomic="true"></div>
      </div>
      <div class="modal-btns">
        <button class="modal-btn-cancel" id="settings-cancel">Cancel</button>
        <button class="modal-btn-ok" id="settings-save">Save</button>
      </div>
    </div>
  </div>

  <div id="logs-overlay" class="modal-overlay hidden" aria-labelledby="logs-title">
    <div class="modal-box logs-modal">
      <div class="picker-head">
        <span class="modal-title" id="logs-title">Logs</span>
        <button id="logs-close" type="button" class="picker-x" aria-label="Close">&#10005;</button>
      </div>
      <div class="logs-tabs">
        <div class="logs-tablist" role="tablist" aria-label="Log view">
          <button id="logs-tab-stdout" type="button" class="logs-tab active" role="tab" aria-selected="true" aria-controls="logs-body" tabindex="0">Output</button>
          <button id="logs-tab-stderr" type="button" class="logs-tab" role="tab" aria-selected="false" aria-controls="logs-body" tabindex="-1">Errors</button>
          <button id="logs-tab-audit" type="button" class="logs-tab" role="tab" aria-selected="false" aria-controls="logs-body" tabindex="-1">Audit</button>
        </div>
        <label class="logs-auto"><input id="logs-autorefresh" type="checkbox"> auto-refresh</label>
        <button id="logs-copy" type="button" class="logs-refresh" title="Copy the shown log to the clipboard so you can paste it into a message">Copy</button>
        <button id="logs-refresh" type="button" class="logs-refresh">Refresh</button>
      </div>
      <div id="logs-meta" class="logs-meta"></div>
      <pre id="logs-body" class="logs-body" role="tabpanel" aria-labelledby="logs-tab-stdout" tabindex="0"></pre>
    </div>
  </div>

  <!-- In-app guide: the README rendered and searchable, so setup and reference live inside the app. -->
  <div id="help-overlay" class="modal-overlay hidden" aria-labelledby="help-title">
    <div class="modal-box help-modal">
      <div class="picker-head">
        <span class="modal-title" id="help-title">Guide</span>
        <button id="help-close" type="button" class="picker-x" aria-label="Close">&#10005;</button>
      </div>
      <div class="help-search">
        <input id="help-search-input" type="search" placeholder="Search the guide…" aria-label="Search the guide" autocomplete="off" spellcheck="false">
        <span id="help-count" class="help-count" aria-live="polite"></span>
        <button id="help-prev" type="button" class="help-nav" title="Previous match" aria-label="Previous match">↑</button>
        <button id="help-next" type="button" class="help-nav" title="Next match" aria-label="Next match">↓</button>
      </div>
      <div id="help-matches" class="help-matches" role="group" aria-label="Matching sections"></div>
      <div id="help-body" class="help-body markdown" tabindex="0"></div>
    </div>
  </div>

  <!-- Automation inbox modal -->
  <div id="inbox-overlay" class="modal-overlay hidden" aria-labelledby="inbox-title">
    <div class="modal-box logs-modal">
      <div class="picker-head">
        <span class="modal-title" id="inbox-title"><svg class="ico" aria-hidden="true"><use href="#ic-inbox"/></svg> Inbox <span class="settings-hint">— scheduled-automation results</span></span>
        <div>
          <button id="inbox-clear" type="button" class="logs-refresh">Clear all</button>
          <button id="inbox-close" type="button" class="picker-x" aria-label="Close">&#10005;</button>
        </div>
      </div>
      <div id="inbox-list" class="inbox-list"></div>
    </div>
  </div>

  <!-- Extraction Tables modal: define columns, pick scope, then run an extraction across the workspace's
       documents into a cited grid that fills live. Exportable as CSV (client-side, no round-trip). -->
  <div id="extract-overlay" class="modal-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="extract-title">
    <div class="modal-box extract-modal">
      <div class="picker-head">
        <span class="modal-title" id="extract-title"><svg class="ico" aria-hidden="true"><use href="#ic-extract"/></svg> Extract table</span>
        <button id="extract-close" type="button" class="picker-x" aria-label="Close">&#10005;</button>
      </div>

      <!-- Setup: define the columns to pull from every document. -->
      <div id="extract-setup">
        <p class="settings-hint">Define the fields to pull from each document. Each value is grounded in that document's own text (with a short evidence quote), and left empty when the document doesn't say — no guessing.</p>
        <div id="extract-columns" class="extract-columns"></div>
        <button id="extract-add-col" type="button" class="extract-addcol">+ Add column</button>
        <label class="extract-scope"><input type="checkbox" id="extract-selected-only"> Only the selected documents</label>
        <div id="extract-setup-msg" class="settings-hint" role="status" aria-live="polite" aria-atomic="true"></div>
      </div>

      <!-- Run: live progress + the table filling in. -->
      <div id="extract-run" class="hidden">
        <div id="extract-progress" class="extract-progress" role="status" aria-live="polite" aria-atomic="true"></div>
        <div id="extract-table-wrap" class="extract-table-wrap"></div>
      </div>

      <div class="picker-actions">
        <button id="extract-cancel" type="button" class="hidden">Cancel</button>
        <button id="extract-export" type="button" class="hidden">Export CSV</button>
        <button id="extract-run-btn" type="button" class="picker-primary">Run extraction</button>
      </div>
    </div>
  </div>

  <!-- Notes: write notes that are stored as first-class documents (indexed, #-citable, auto-linked). A list
       on the left, an editor on the right, and a "related" strip that reuses the similarity code. -->
  <div id="notes-overlay" class="modal-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="notes-title">
    <div class="modal-box notes-modal">
      <div class="picker-head">
        <span class="modal-title" id="notes-title"><svg class="ico" aria-hidden="true"><use href="#ic-notes"/></svg> Notes</span>
        <button id="notes-close" type="button" class="picker-x" aria-label="Close">&#10005;</button>
      </div>
      <div class="notes-body">
        <div class="notes-sidebar">
          <button id="notes-new" type="button" class="notes-new">+ New note</button>
          <div id="notes-list" class="notes-list"></div>
        </div>
        <div class="notes-editor">
          <input id="note-title" type="text" class="note-title" placeholder="Note title" aria-label="Note title" maxlength="80">
          <textarea id="note-body" class="note-body" placeholder="Write your note in Markdown. It becomes a searchable, #-citable document." aria-label="Note body"></textarea>
          <div class="notes-actions">
            <button id="note-save" type="button" class="picker-primary">Save note</button>
            <button id="note-delete" type="button" class="hidden">Delete</button>
            <span id="note-msg" class="settings-hint" role="status" aria-live="polite" aria-atomic="true"></span>
          </div>
          <div id="note-related" class="note-related"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Corpus mind-map: an interactive force-directed map of the workspace's knowledge-graph entities and
       how they connect. Click a node to ask about that entity. Rendered as inline SVG (no library). -->
  <div id="mindmap-overlay" class="modal-overlay hidden" role="dialog" aria-modal="true" aria-labelledby="mindmap-title">
    <div class="modal-box mindmap-modal">
      <div class="picker-head">
        <span class="modal-title" id="mindmap-title"><svg class="ico" aria-hidden="true"><use href="#ic-map"/></svg> Corpus mind-map</span>
        <div>
          <span id="mindmap-meta" class="settings-hint"></span>
          <button id="mindmap-close" type="button" class="picker-x" aria-label="Close">&#10005;</button>
        </div>
      </div>
      <div id="mindmap-body" class="mindmap-body">
        <div id="mindmap-status" class="mindmap-status"></div>
        <svg id="mindmap-svg" class="mindmap-svg" role="img" aria-label="Entity map"></svg>
      </div>
      <div id="mindmap-footer" class="mindmap-footer"></div>
      <div id="mindmap-live" class="sr-only" aria-live="polite"></div>
    </div>
  </div>

  <div id="why-overlay" class="modal-overlay hidden" aria-labelledby="why-title">
    <div class="modal-box why-modal">
      <div class="picker-head">
        <span class="modal-title" id="why-title">Why this answer</span>
        <button id="why-close" type="button" class="picker-x" aria-label="Close">&#10005;</button>
      </div>
      <div id="why-body" class="why-body"></div>
    </div>
  </div>

  <div id="picker-overlay" class="modal-overlay hidden" aria-labelledby="picker-title">
    <div class="modal-box picker-modal">
      <div class="picker-head">
        <span class="modal-title" id="picker-title">Choose a folder</span>
        <button id="picker-close" type="button" class="picker-x" aria-label="Close">&#10005;</button>
      </div>
      <div id="picker-volumes" class="picker-volumes"></div>
      <div id="picker-current" class="picker-current"></div>
      <div id="picker-list" class="picker-list"></div>
      <div class="picker-actions">
        <button id="picker-cancel" type="button">Cancel</button>
        <button id="picker-select" type="button" class="picker-primary">Use this folder</button>
      </div>
    </div>
  </div>

  <!-- In-app source viewer. Opening a cited source stays inside the app (a same-origin iframe
       for a local document, a clean reader for a web result) rather than a new OS window, so it
       works identically in the browser and the desktop app. -->
  <div id="source-overlay" class="modal-overlay hidden" aria-labelledby="source-title">
    <div class="modal-box source-modal">
      <div class="picker-head">
        <span class="modal-title" id="source-title">Source</span>
        <div class="source-head-actions">
          <a id="source-open-original" class="source-open-original hidden" target="_blank" rel="noopener noreferrer">Open original ↗</a>
          <button id="source-close" type="button" class="picker-x" aria-label="Close">&#10005;</button>
        </div>
      </div>
      <!-- tabindex 0 so a keyboard user can focus and scroll the embedded document / reader
           (neither an iframe nor a div is focusable by default). -->
      <iframe id="source-frame" class="source-frame hidden" title="Document viewer" tabindex="0"></iframe>
      <div id="source-reader" class="source-reader hidden" tabindex="0"></div>
    </div>
  </div>

  <!-- Backdrop for a mobile bottom sheet (the Tools panel). It is hidden on desktop and whenever no
       sheet is open, so the persistent sidebar and popovers are unaffected. -->
  <div id="sheet-backdrop" class="sheet-backdrop" hidden aria-hidden="true"></div>

  <!-- Socket.IO and marked: self-hosted from node_modules, no CDN -->
  <script src="/ws/socket.io.js"></script>
  <script src="/vendor/marked/marked.umd.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : 0 %>"></script>
  <!-- The hands-free turn detector (window.LokyniVAD), loaded before chat.js which uses it. -->
  <script src="/js/vad.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : 0 %>"></script>
  <script src="/js/chat.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : 0 %>"></script>

  <!-- Account menu wiring. Self-contained so it needs no change to chat.js: it asks the server who is
       signed in and reveals the Account / Users / Sign-out rows accordingly. In single-user mode (no
       accounts yet) these stay hidden. -->
  <script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
  (function () {
    // Show the read-replica banner when this instance is a replica (multi-instance deployments).
    fetch('/status', { headers: { accept: 'application/json' } }).then(function (r) { return r.json(); }).then(function (st) {
      if (st && st.cluster === 'replica') { var b = document.getElementById('replica-banner'); if (b) { b.hidden = false; b.style.display = ''; } }
    }).catch(function () {});

    fetch('/auth/me', { headers: { accept: 'application/json' } }).then(function (r) { return r.json(); }).then(function (s) {
      if (!s.authRequired) {
        // Single-user (implicit owner): offer a way to turn on accounts and share with a team.
        var setup = document.getElementById('acct-setup-row');
        if (setup && s.needsFirstAccount) setup.hidden = false;
        return;
      }
      var acct = document.getElementById('acct-account-row');
      var users = document.getElementById('acct-users-row');
      var logout = document.getElementById('acct-logout-row');
      var name = document.getElementById('acct-name');
      if (acct) acct.hidden = false;
      if (logout) logout.hidden = false;
      if (users) users.hidden = !s.isAdmin;
      if (name && s.user) name.textContent = 'Signed in as ' + (s.user.name || s.user.username);
      if (logout) logout.addEventListener('click', function () {
        fetch('/auth/logout', { method: 'POST', headers: { 'x-csrf-token': s.csrfToken || '', accept: 'application/json' } })
          .then(function () { location.href = '/login'; })
          .catch(function () { location.href = '/login'; });
      });
    }).catch(function () { /* if the probe fails, leave the account menu hidden */ });
  })();
  </script>

</body>
</html>
