<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Account · <%= appName %></title>
  <meta name="theme-color" content="#0f0f0f" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#f0f0ee" media="(prefers-color-scheme: light)">
  <meta name="color-scheme" content="dark">
  <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/fonts/fonts.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : 0 %>">
  <link rel="stylesheet" href="/css/app.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : 0 %>">
  <script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">(function(){try{var t=localStorage.getItem('theme');if(t==='light'||t==='sepia')document.documentElement.classList.add(t);var bg={light:'#f0f0ee',sepia:'#f4ecd8'}[t]||'#0f0f0f';document.querySelectorAll('meta[name="theme-color"]').forEach(function(m){m.remove();});var m=document.createElement('meta');m.setAttribute('name','theme-color');m.setAttribute('content',bg);document.head.appendChild(m);}catch(e){}})();</script>
  <style>
    /* This is a standalone, scrolling page, not the chat app shell: override app.css's fixed flex-column
       body so the centered wrapper constrains to the viewport width. Without this, a flex item with auto
       side margins sizes to its content and a long session user-agent string pushes the page wider than the
       screen (horizontal scroll on a phone). Mirrors admin-users.ejs. */
    body { display: block; height: auto; min-height: 100dvh; }
    .acct-wrap { max-width: 640px; margin: 0 auto; padding: 24px 16px calc(40px + env(safe-area-inset-bottom,0px)); }
    .acct-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; gap: 12px; }
    .acct-top h1 { font-size: 20px; margin: 0; color: var(--text); }
    .acct-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 18px; }
    .acct-card h2 { font-size: 14px; margin: 0 0 12px; color: var(--text); text-transform: uppercase; letter-spacing: .05em; }
    .acct-card label { display: block; font-size: 12px; color: var(--text-mid); margin: 12px 0 6px; }
    .acct-card input { width: 100%; max-width: 100%; box-sizing: border-box; padding: 9px 11px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--text); font-size: 16px; }
    .acct-card input:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--accent); }
    .btn { padding: 9px 14px; border: none; border-radius: 8px; background: var(--accent-strong); color: #fff; font-size: 14px; font-weight: 600; cursor: pointer; }
    .btn.secondary { background: transparent; color: var(--text-mid); border: 1px solid var(--border); }
    .btn:disabled { opacity: .6; cursor: default; }
    .msg { font-size: 13px; margin-top: 10px; min-height: 16px; }
    .msg.error { color: var(--error); } .msg.ok { color: var(--accent); }
    .sess { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 10px; padding: 8px 0; border-top: 1px solid var(--border); font-size: 13px; color: var(--text-mid); }
    /* A long user-agent string must be able to shrink and wrap, or it forces the row (and the page) wider
       than the viewport. min-width:0 lets the flex item shrink below its content; overflow-wrap breaks it. */
    .sess span { min-width: 0; overflow-wrap: anywhere; }
    .sess:first-of-type { border-top: none; }
    .muted { color: var(--text-mid); font-size: 12px; }
  </style>
</head>
<body>
  <div class="acct-wrap">
    <div class="acct-top">
      <h1>Account</h1>
      <a class="btn secondary" href="/">← Back to <%= appName %></a>
    </div>

    <div class="acct-card">
      <h2>Signed in</h2>
      <p id="who" class="muted">Loading…</p>
      <button class="btn secondary" id="logout-btn" type="button">Sign out</button>
    </div>

    <div class="acct-card">
      <h2>Display name</h2>
      <form id="dn-form">
        <label for="dn">Your name <span class="muted">(shown to others; any language)</span></label>
        <input id="dn" type="text" maxlength="64" autocomplete="name" placeholder="e.g. your full name">
        <div style="margin-top:14px;"><button class="btn" id="dn-btn" type="submit">Save name</button></div>
        <div class="msg" id="dn-msg" role="status" aria-live="polite" aria-atomic="true"></div>
      </form>
      <p class="muted" style="margin-top:8px;">Your username (how you sign in) does not change.</p>
    </div>

    <div class="acct-card">
      <h2>Change password</h2>
      <form id="pw-form">
        <label for="cur">Current password</label>
        <input id="cur" type="password" autocomplete="current-password" required>
        <label for="new1">New password <span class="muted" id="pw-hint">(at least 8 characters)</span></label>
        <input id="new1" type="password" autocomplete="new-password" minlength="8" required>
        <label for="new2">Confirm new password</label>
        <input id="new2" type="password" autocomplete="new-password" minlength="8" required>
        <div style="margin-top:14px;"><button class="btn" id="pw-btn" type="submit">Update password</button></div>
        <div class="msg" id="pw-msg" role="status" aria-live="polite" aria-atomic="true"></div>
      </form>
      <p class="muted" style="margin-top:8px;">Changing your password signs out your other sessions.</p>
    </div>

    <div class="acct-card">
      <h2>Active sessions</h2>
      <div id="sessions"><p class="muted">Loading…</p></div>
      <div style="margin-top:12px;"><button class="btn secondary" id="revoke-btn" type="button">Sign out everywhere else</button></div>
      <div class="msg" id="sess-msg" role="status" aria-live="polite" aria-atomic="true"></div>
    </div>
  </div>

  <script src="/js/authpage.js?v=<%= assetVersion %>" nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>"></script>
  <script nonce="<%= typeof nonce !== 'undefined' ? nonce : '' %>">
  (function () {
    // CSRF token, request-header builder, and HTML-escaper are shared with the admin page (see authpage.js).
    var esc = AuthPage.esc, hdrs = AuthPage.hdrs;

    AuthPage.me(function (s) {
      if (!s.authenticated) { location.href = '/login'; return; }
      // Show the resolved display name (server-computed: display name, else username), and the @username when they
      // differ so the sign-in identifier stays visible.
      if (s.user) {
        var label = s.user.name + (s.user.name !== s.user.username ? ' (@' + s.user.username + ')' : '') + (s.user.role === 'admin' ? ' (administrator)' : '');
        document.getElementById('who').textContent = label;
        var dn = document.getElementById('dn'); if (dn) dn.value = s.user.displayName || '';
      } else {
        document.getElementById('who').textContent = 'this device';
      }
      // Source the min-length hint + minlength from the server policy so they can't drift from enforcement.
      if (typeof s.minPasswordLen === 'number') {
        var hint = document.getElementById('pw-hint'); if (hint) hint.textContent = '(at least ' + s.minPasswordLen + ' characters)';
        var n1 = document.getElementById('new1'), n2 = document.getElementById('new2');
        if (n1) n1.minLength = s.minPasswordLen; if (n2) n2.minLength = s.minPasswordLen;
      }
      loadSessions();
    }).catch(function () {});

    document.getElementById('logout-btn').addEventListener('click', function () {
      fetch('/auth/logout', { method: 'POST', headers: hdrs(false) }).then(function () { location.href = '/login'; }).catch(function () { location.href = '/login'; });
    });

    document.getElementById('dn-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var m = document.getElementById('dn-msg'); m.className = 'msg'; m.textContent = '';
      var btn = document.getElementById('dn-btn'); btn.disabled = true;
      fetch('/auth/me', { method: 'PATCH', headers: hdrs(true), body: JSON.stringify({ displayName: document.getElementById('dn').value }) })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) {
          btn.disabled = false;
          if (res.ok && res.j.ok) {
            m.className = 'msg ok'; m.textContent = 'Name saved.';
            var u = res.j.user || {};
            document.getElementById('dn').value = u.displayName || '';
            var who = document.getElementById('who');
            if (who && u.name) who.textContent = u.name + (u.name !== u.username ? ' (@' + u.username + ')' : '') + (u.role === 'admin' ? ' (administrator)' : '');
          } else { m.className = 'msg error'; m.textContent = (res.j && res.j.error) || 'Could not save your name.'; }
        }).catch(function () { btn.disabled = false; m.className = 'msg error'; m.textContent = 'Could not reach the server.'; });
    });

    document.getElementById('pw-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var m = document.getElementById('pw-msg'); m.className = 'msg'; m.textContent = '';
      var n1 = document.getElementById('new1').value, n2 = document.getElementById('new2').value;
      if (n1 !== n2) { m.className = 'msg error'; m.textContent = 'The new passwords do not match.'; return; }
      var btn = document.getElementById('pw-btn'); btn.disabled = true;
      fetch('/auth/password', { method: 'POST', headers: hdrs(true), body: JSON.stringify({ currentPassword: document.getElementById('cur').value, newPassword: n1 }) })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) {
          btn.disabled = false;
          if (res.ok && res.j.ok) { m.className = 'msg ok'; m.textContent = 'Password updated. Other sessions were signed out.'; document.getElementById('pw-form').reset(); loadSessions(); }
          else { m.className = 'msg error'; m.textContent = (res.j && res.j.error) || 'Could not update the password.'; }
        }).catch(function () { btn.disabled = false; m.className = 'msg error'; m.textContent = 'Could not reach the server.'; });
    });

    function loadSessions() {
      fetch('/auth/sessions', { headers: { accept: 'application/json' } }).then(function (r) { return r.json(); }).then(function (s) {
        var el = document.getElementById('sessions');
        if (!s.sessions || !s.sessions.length) { el.innerHTML = '<p class="muted">No active sessions.</p>'; return; }
        el.innerHTML = s.sessions.map(function (x) {
          var when = new Date(x.lastSeen || x.created).toLocaleString();
          return '<div class="sess"><span>' + esc(x.ua || 'Unknown device') + (x.current ? ' <b>(this device)</b>' : '') + '</span><span>' + esc(x.ip || '') + ' · ' + esc(when) + '</span></div>';
        }).join('');
      }).catch(function () {});
    }

    document.getElementById('revoke-btn').addEventListener('click', function () {
      // Confirm — this signs out every OTHER device, which each then has to sign in again.
      AuthPage.confirm({ title: 'Sign out everywhere else?', message: 'Every other signed-in device will have to sign in again. This device stays signed in.', okLabel: 'Sign out others', danger: true }).then(function (ok) {
        if (!ok) return;
        var m = document.getElementById('sess-msg'); m.className = 'msg'; m.textContent = '';
        fetch('/auth/sessions', { method: 'DELETE', headers: hdrs(false) }).then(function (r) { return r.json(); }).then(function (j) {
          m.className = 'msg ok'; m.textContent = 'Signed out ' + (j.revoked || 0) + ' other session(s).'; loadSessions();
        }).catch(function () { m.className = 'msg error'; m.textContent = 'Could not revoke sessions.'; });
      });
    });
  })();
  </script>
</body>
</html>
