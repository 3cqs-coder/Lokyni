{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lokyni",
  "version": "../package.json",
  "identifier": "com.3cqs.lokyni",
  "build": {
    "frontendDist": "ui",
    "beforeBuildCommand": "npm run tauri:prepare"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi", "deb", "rpm"],
    "publisher": "3CQS",
    "copyright": "Copyright (C) 3CQS",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "app": "app"
    },
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
